<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Glance.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Glance">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>

            <!-- 【Glance 色板】强调色 = Obsidian 紫；未选中底 = 跟随主题的半透明 ControlFill。

                 ⚠ 覆盖层级（踩过坑，别改回去）：
                     generic.xaml:548 是
                        <StaticResource x:Key="ToggleButtonBackgroundChecked"
                                        ResourceKey="AccentFillColorDefaultBrush" />
                     这是【静态别名】，在 generic.xaml 自己的字典里就解析完了 —— 在下面重定义
                     AccentFillColorDefaultBrush 渗不进 ToggleButton 的检查态。
                     ⇒ 能换色的层级只有 ToggleButtonBackgroundChecked* / ToggleButtonBackground*，
                       不是 AccentFillColor*。

                 ⚠ 主题字典必须把接管器用到的【每一个键】都定义齐（09-27 第三轮教训）：
                     ToggleButtonVisualOverride.Resource() 查不到时会退回顶层字典，而顶层里躺着
                     generic 提升上来的【Light 档】值 ⇒ 深色模式下没定义的键全部拿到浅色值：
                       Foreground 没定义 ⇒ 深色下图标是黑线（实测笔画 #060606）；
                       ForegroundChecked 没定义 ⇒ 深色下亮紫底配白字（对比只有 ~3:1）。
                     ⇒ 下面两个主题字典的键集合必须一一对应，新增档位时两边一起加。

                 【未选中底为什么用半透明（09-27 第三轮，第二版 #393939 被否）】
                     工具栏是半透明亚克力，会透出底下 PDF 的颜色 ⇒ 背景逐像素在变；
                     普通 Button 的底 = ControlFillColor*（白 + alpha），跟着亚克力一起变；
                     我们贴一块不透明 #393939 就永远是"贴片"，怎么调都和旁边对不上。
                     ⇒ 深色未选中三档直接引用 generic 深色的 ControlFillColor{Default,Secondary,Tertiary}
                       （#0FFFFFFF / #15FFFFFF / #08FFFFFF），与普通 Button 完全同源。
                     浅色工具栏目前不透明（#FDFDFD 实测），纯白三档用户已验收，保持不动。

                 【主题字典的键】WinUI 顶层 ThemeDictionaries 只有 Default / Light / HighContrast，
                   没有 "Dark"（暗色值在 Default 里）。这里同样只写 Default + Light。 -->

            <ResourceDictionary.ThemeDictionaries>

                <!-- ══ 深色（WinUI 的 "Default" 档，不是 "Dark"）══ -->
                <ResourceDictionary x:Key="Default">
                    <!-- GlanceAccent (Obsidian 紫) 直接内联为画刷 Color 字面量，避免 <Color> 资源元素触发
                         WMC0001 "Unknown type 'Color'"。深色未选中底走 ControlFillColor*，原深色的
                         GlanceFillNeutral* 纵深防御三档已无引用方（根因在 a265ad4 移除），随本修复一并删除。 -->

                    <!-- 欢迎页"打开文件"按钮专用画刷（第 12 轮）。
                         ⚠ 第 11 轮在主题字典覆盖 generic 的 AccentButtonBackground* 键【无效】：按钮仍是系统蓝。
                           根因 = XamlControlsResources 内部的 {ThemeResource AccentButtonBackground*} 只在 generic
                           自己的字典链解析，不回查 App 主题字典（与 AccentFillColor* 渗不进同族陷阱）。
                         ⇒ 正解 = App 自有 Style（GlanceAccentButtonStyle，见 ThemeDictionaries 之后）+ 模板，
                           模板动画只引用下面三支画刷。App 引 generic 的键方向正常（工具栏三档半透白即证据）。 -->
                    <SolidColorBrush x:Key="GlanceAccentBrush" Color="#A882FF" />
                    <SolidColorBrush x:Key="GlanceAccentBrushPointerOver" Color="#A882FF" Opacity="0.9" />
                    <SolidColorBrush x:Key="GlanceAccentBrushPressed" Color="#A882FF" Opacity="0.8" />

                    <!-- 欢迎页打开 PDF 按钮（accent 模式）的【显式】文字画刷：不依赖 WinUI 自适应的
                         TextOnAccentFillColorPrimary（它会随系统强调色 / 主题错位，曾导致深色调悬浮态文字错变白、
                         且 hover 卡 true 后无法回落）。深色档调回 #A882FF（偏亮 ⇒ 黑字 7.3:1，与原 Glance 紫一致）；
                         浅色档 #9873F7 偏亮，按用户决定保留白字（已实测可接受）、不翻黑。
                         normal / hover 同源（文字恒定，只靠背景 1.0/0.9 梯度表状态），pressed 略压一档。定义见两主题字典。 -->
                    <SolidColorBrush x:Key="GlanceAccentForeground" Color="#000000" />
                    <SolidColorBrush x:Key="GlanceAccentForegroundPressed" Color="#595959" />

                    <!-- 未选中：generic 深色档同源的三档半透明白，跟亚克力一起走（第 8 轮透明化已回退） -->
                    <SolidColorBrush x:Key="ToggleButtonBackground"
                                     Color="{ThemeResource ControlFillColorDefault}" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver"
                                     Color="{ThemeResource ControlFillColorSecondary}" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundPressed"
                                     Color="{ThemeResource ControlFillColorTertiary}" />

                    <!-- （缩放胶囊 4 颗的静止档现已改为【完全透明】，与浮层 8 颗共用 transparentAtRest，
                         不再需要专属的静止档画刷 —— 见 ButtonVisualOverride.Apply 的透明档分支。） -->

                    <!-- 缩放胶囊 4 颗的悬浮/点击态（10-05，第二轮：更透明）：深浅色【共用同一关系】——
                         悬浮=胶囊反色的【淡 frosted 叠加】（≈16% 白，只轻微提亮、亚克力照透），
                         按下=靠近胶囊色的【极淡叠加】（≈5% 黑，几乎贴回胶囊）。
                         本档为深色胶囊（暗）⇒ 悬浮 #29FFFFFF / 按下 #0D000000；浅色档对称反向（见 Light 字典）。
                         ⚠ 第三轮(10-05)起 hover/pressed 的【alpha 与浅色档一致】(hover 16% / pressed 5%)，
                         只翻转色相以反色：深=白、浅=偏灰的黑(#3A3A3A)；两模式叠加"强度"相同、亚克力透出一致。
                         （注：上一步曾把深色也降到 8% 想对齐，用户要求深色保持 16% 不动 ⇒ 改为浅色提回 16% 并改用偏灰黑柔化，
                          而非压低深色 alpha。）
                         作用于缩放胶囊 4 颗 + 浮层预设 8 颗（均 transparentAtRest）：两者 hover 事件源不同
                         （浮层在 popup 独立树、由 ZoomPresetPanel 驱动；胶囊在主树、由整页驱动），但 hover/按下配色同源都用本档。
                         前景复用静止档（ToggleButtonForeground），不另起键 ⇒ 文字不随悬浮跳动、对比更小。 -->
                    <SolidColorBrush x:Key="ZoomPillButtonHoverBackground" Color="#29FFFFFF" />
                    <SolidColorBrush x:Key="ZoomPillButtonPressedBackground" Color="#0D000000" />

                    <!-- 未选中前景：TextFillColorPrimary 深色 = #FFFFFF（黑线问题的修复点） -->
                    <SolidColorBrush x:Key="ToggleButtonForeground"
                                     Color="{ThemeResource TextFillColorPrimary}" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundPointerOver"
                                     Color="{ThemeResource TextFillColorPrimary}" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundPressed"
                                     Color="{ThemeResource TextFillColorSecondary}" />

                    <!-- 未选中边框：深色档。原生 9%/7% 白渐变在暗底上偏白（用户 09-28 反馈"边框偏白，要再黑一点"），
                         改回 subdued 的均匀细描边 4~7% 白（第 6 轮"深色还好"档位），比原生更黑、不再发亮。
                         浅色档仍照抄原生（带翻转）。 -->
                    <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="#0AFFFFFF" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="#0EFFFFFF" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="#12FFFFFF" />

                    <!-- 已选中前景：TextOnAccentFillColorPrimary 深色 = #000000，黑字压亮紫 7.3:1
                         （之前漏定义，深色拿到 Light 档的白字，对比掉到 ~3:1） -->
                    <SolidColorBrush x:Key="ToggleButtonForegroundChecked"
                                     Color="{ThemeResource TextOnAccentFillColorPrimary}" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver"
                                     Color="{ThemeResource TextOnAccentFillColorPrimary}" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed"
                                     Color="{ThemeResource TextOnAccentFillColorSecondary}" />

                    <!-- 已选中边框：照抄原生 AccentControlElevationBorderBrush(generic:2158，深色档无翻转)。
                         顶 OnAccentSecondary / 底 OnAccentDefault，与原生强调按钮一致。Pressed 透明。 -->
                    <LinearGradientBrush x:Key="ToggleButtonBorderBrushChecked" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,3">
                        <LinearGradientBrush.GradientStops>
                            <GradientStop Offset="0.33" Color="{ThemeResource ControlStrokeColorOnAccentSecondary}" />
                            <GradientStop Offset="1.0" Color="{ThemeResource ControlStrokeColorOnAccentDefault}" />
                        </LinearGradientBrush.GradientStops>
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,3">
                        <LinearGradientBrush.GradientStops>
                            <GradientStop Offset="0.33" Color="{ThemeResource ControlStrokeColorOnAccentSecondary}" />
                            <GradientStop Offset="1.0" Color="{ThemeResource ControlStrokeColorOnAccentDefault}" />
                        </LinearGradientBrush.GradientStops>
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="#00FFFFFF" />

                    <!-- 已选中：Obsidian 紫。0.9 / 0.8 两档沿用 generic 的 AccentFill* 梯度 -->
                    <SolidColorBrush x:Key="ToggleButtonBackgroundChecked"
                                     Color="#A882FF" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver"
                                     Color="#A882FF" Opacity="0.9" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed"
                                     Color="#A882FF" Opacity="0.8" />
                </ResourceDictionary>

                <!-- ══ 浅色 ══ -->
                <ResourceDictionary x:Key="Light">
                    <!-- GlanceAccent (Obsidian 紫 · 浅色档 #9873F7) 内联为画刷 Color 字面量，避免 <Color> 资源元素触发 WMC0001。 -->

                    <!-- 欢迎页按钮专用画刷（与深色档同层级、同梯度；说明见深色档注释） -->
                    <SolidColorBrush x:Key="GlanceAccentBrush" Color="#9873F7" />
                    <SolidColorBrush x:Key="GlanceAccentBrushPointerOver" Color="#9873F7" Opacity="0.9" />
                    <SolidColorBrush x:Key="GlanceAccentBrushPressed" Color="#9873F7" Opacity="0.8" />

                    <!-- 欢迎页打开 PDF 按钮（accent 模式）的【显式】文字画刷：与深色档同键、同语义（说明见深色档注释）。
                         浅色调紫(#9873F7)偏亮 ⇒ 文字白会跌破 AA(3.4:1)；若要保持可读应改黑(6.1:1)。
                         pressed 略压一档。normal / hover 同源（文字恒定，只靠背景 1.0/0.9 梯度表状态）。 -->
                    <SolidColorBrush x:Key="GlanceAccentForeground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="GlanceAccentForegroundPressed" Color="#E6E6E6" />

                    <!-- 浅色中性底标定（09-27 截图实测）：侧栏面板 #F3F3F3 / 工具栏 #FDFDFD。
                         纯白对齐同屏普通 Button，用户已验收；悬停/按下向灰压一/两档。三档字面量已直接内联到
                         ToggleButtonBackground* 画刷（见下），不再以 <Color> 资源定义，避免 WMC0001。 -->

                    <SolidColorBrush x:Key="ToggleButtonBackground"
                                     Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver"
                                     Color="#F6F6F6" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundPressed"
                                     Color="#ECECEC" />

                    <!-- （缩放胶囊 4 颗的静止档现已改为【完全透明】，与浮层 8 颗共用 transparentAtRest，
                         不再需要专属的静止档画刷 —— 见 ButtonVisualOverride.Apply 的透明档分支。） -->

                    <!-- 缩放胶囊 4 颗悬浮/点击态（10-05，第二轮：更透明）：与深色档【同关系】——深色胶囊暗⇒悬浮淡白/按下淡黑；
                         浅色胶囊亮⇒对称反向：悬浮 #293A3A3A(≈16% 偏灰黑 #3A3A3A，比纯黑柔、对比更小)/按下 #0DFFFFFF(≈5% 白，贴回胶囊)，
                         hover/pressed 的【alpha 与深色档一致】(16%/5%)，仅色相翻转 ⇒ 两模式叠加强度相同、亚克力透出一致。 -->
                    <SolidColorBrush x:Key="ZoomPillButtonHoverBackground" Color="#293A3A3A" />
                    <SolidColorBrush x:Key="ZoomPillButtonPressedBackground" Color="#0DFFFFFF" />

                    <!-- 前景/边框与深色字典同一段 markup —— ThemeResource 会按主题各自解析 -->
                    <SolidColorBrush x:Key="ToggleButtonForeground"
                                     Color="{ThemeResource TextFillColorPrimary}" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundPointerOver"
                                     Color="{ThemeResource TextFillColorPrimary}" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundPressed"
                                     Color="{ThemeResource TextFillColorSecondary}" />

                    <!-- 未选中边框：照抄原生 ControlElevationBorderBrush(generic:7747，浅色档带 ScaleY=-1 翻转)
                         ⇒ 顶 6% 黑 / 底 16% 黑，底部更重营造立体感（用户观察正确），且比统一 6% 更可见。 -->
                    <LinearGradientBrush x:Key="ToggleButtonBorderBrush" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,3">
                        <LinearGradientBrush.RelativeTransform>
                            <ScaleTransform ScaleY="-1" CenterY="0.5" />
                        </LinearGradientBrush.RelativeTransform>
                        <LinearGradientBrush.GradientStops>
                            <GradientStop Offset="0.33" Color="{ThemeResource ControlStrokeColorSecondary}" />
                            <GradientStop Offset="1.0" Color="{ThemeResource ControlStrokeColorDefault}" />
                        </LinearGradientBrush.GradientStops>
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="ToggleButtonBorderBrushPointerOver" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,3">
                        <LinearGradientBrush.RelativeTransform>
                            <ScaleTransform ScaleY="-1" CenterY="0.5" />
                        </LinearGradientBrush.RelativeTransform>
                        <LinearGradientBrush.GradientStops>
                            <GradientStop Offset="0.33" Color="{ThemeResource ControlStrokeColorSecondary}" />
                            <GradientStop Offset="1.0" Color="{ThemeResource ControlStrokeColorDefault}" />
                        </LinearGradientBrush.GradientStops>
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed"
                                     Color="{ThemeResource ControlStrokeColorDefault}" />

                    <SolidColorBrush x:Key="ToggleButtonForegroundChecked"
                                     Color="{ThemeResource TextOnAccentFillColorPrimary}" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver"
                                     Color="{ThemeResource TextOnAccentFillColorPrimary}" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed"
                                     Color="{ThemeResource TextOnAccentFillColorSecondary}" />

                    <!-- 已选中边框：照抄原生 AccentControlElevationBorderBrush(generic:2158 浅色档，带翻转)
                         ⇒ 底 OnAccentSecondary(浅色 40% 黑) 更重、顶 OnAccentDefault(8% 白)，与原生强调按钮一致。 -->
                    <LinearGradientBrush x:Key="ToggleButtonBorderBrushChecked" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,3">
                        <LinearGradientBrush.RelativeTransform>
                            <ScaleTransform ScaleY="-1" CenterY="0.5" />
                        </LinearGradientBrush.RelativeTransform>
                        <LinearGradientBrush.GradientStops>
                            <GradientStop Offset="0.33" Color="{ThemeResource ControlStrokeColorOnAccentSecondary}" />
                            <GradientStop Offset="1.0" Color="{ThemeResource ControlStrokeColorOnAccentDefault}" />
                        </LinearGradientBrush.GradientStops>
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,3">
                        <LinearGradientBrush.RelativeTransform>
                            <ScaleTransform ScaleY="-1" CenterY="0.5" />
                        </LinearGradientBrush.RelativeTransform>
                        <LinearGradientBrush.GradientStops>
                            <GradientStop Offset="0.33" Color="{ThemeResource ControlStrokeColorOnAccentSecondary}" />
                            <GradientStop Offset="1.0" Color="{ThemeResource ControlStrokeColorOnAccentDefault}" />
                        </LinearGradientBrush.GradientStops>
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="#00FFFFFF" />

                    <SolidColorBrush x:Key="ToggleButtonBackgroundChecked"
                                     Color="#9873F7" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver"
                                     Color="#9873F7" Opacity="0.9" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed"
                                     Color="#9873F7" Opacity="0.8" />
                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>

            <!-- 欢迎页"打开文件"按钮专用强调样式（第 12 轮创建；10-05 改为无状态机）。
                 覆盖 generic 的 AccentButtonBackground* 主题键无效（XamlControlsResources 内部 ThemeResource
                 不回查 App 主题字典，实测仍是系统蓝）⇒ 自有 Style + 模板。初始配色引用上面字典里的
                 GlanceAccentBrush{,PointerOver,Pressed}（Obsidian 紫三档）；文字/边框引用 generic 的
                 TextOnAccent* / AccentControlElevationBorderBrush（App 引 generic 方向正常）。
                 模板骨架照抄 generic:8896-8956（AccentButtonStyle），但【已删除 VisualStateGroups 与
                 BackgroundTransition】—— 该按钮原本靠原生 VSM 驱动 hover/pressed，点击弹文件选择器时输入
                 上下文切换、无法判定鼠标是否仍在按钮上 ⇒ VSM 的 Pressed→Normal→PointerOver 在快速点击下
                 闪烁（用户实测 flicker）。10-05 把视觉独占权交给 ButtonVisualOverride 的 accent 模式
                 （Apply 的 _accent 分支按几何 hover + IsPressed 写同三档紫 + 同边框/前景），与本类其它
                 接管按钮同源、flicker 根因消除。Disabled 档极少触发（欢迎页按钮恒可用），保持静止紫即可。 -->
            <Style x:Key="GlanceAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="Foreground" Value="{ThemeResource GlanceAccentForeground}" />
                <Setter Property="Background" Value="{ThemeResource GlanceAccentBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AccentControlElevationBorderBrush}" />
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                <Setter Property="BackgroundSizing" Value="OuterBorderEdge" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter x:Name="ContentPresenter" Background="{TemplateBinding Background}" BackgroundSizing="{TemplateBinding BackgroundSizing}" Foreground="{TemplateBinding Foreground}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" ContentTransitions="{TemplateBinding ContentTransitions}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" AutomationProperties.AccessibilityView="Raw"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Other app resources here -->
        </ResourceDictionary>
    </Application.Resources>
</Application>
