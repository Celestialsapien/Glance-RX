<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="GlanceRX.GpuPageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GlanceRX"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
      Phase 2.3 视口画布架构（内存硬上限）：
      - ScreenCanvas：仅视口大小的 CanvasControl（~25MB 固定），每次滚动/缩放重画可见页。
        画 2-3 张已缓存的 GPU 位图是微秒级操作，60fps 无压力。
      - Viewer(ScrollViewer)：只承载一个透明 Spacer 撑出文档尺寸 → 提供原生滚动条/惯性/缩放手势。
        ScrollViewer 叠在画布上层(自身透明)，滚动条可见、输入正常。
      - 内存 = 视口画布(固定) + 页位图 LRU(5页±240MB 封顶) + 像素池(~128MB 封顶)，
        与滚动距离/文档长度无关。彻底替代"整文档一块虚拟表面"(其分块只标脏不释放，
        滚完全本必然 ~950MB)。
    -->
    <!-- 跟随深浅主题：浅色 #F3F3F3 / 深色 #202020（与 MainPage 视图区一致） -->
    <Grid x:Name="RootGrid" SizeChanged="RootGrid_SizeChanged"
          Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <canvas:CanvasControl x:Name="ScreenCanvas"
                              IsHitTestVisible="False"
                              CreateResources="ScreenCanvas_CreateResources"
                              Draw="ScreenCanvas_Draw"/>

        <!-- UseSystemFocusVisuals=False：Viewer 只是为了承接快捷键(F/G)而可聚焦，不需要系统焦点矩形。
             否则按 Esc 退出卡片编辑（EndCanvasEdit → RestoreViewerFocus → Viewer.Focus）时，
             键盘输入模态会让系统在视口四周画出高可见性焦点框（主框在深色主题下为白色）＝"一圈白线"。 -->
        <ScrollViewer x:Name="Viewer"
                      IsTabStop="True"
                      Background="Transparent"
                      UseSystemFocusVisuals="False"
                      HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled"
                      VerticalScrollBarVisibility="Auto" VerticalScrollMode="Enabled"
                      ZoomMode="Disabled" MinZoomFactor="0.1" MaxZoomFactor="4.0"
                      SizeChanged="Viewer_SizeChanged"
                      ViewChanged="Viewer_ViewChanged"
                      DoubleTapped="Viewer_DoubleTapped">
            <!-- 透明占位：撑出文档总尺寸，提供滚动范围；Background=Transparent 保证可命中(手势/滚轮) -->
            <Grid x:Name="Spacer" Background="Transparent"/>
        </ScrollViewer>

        <!-- 白板交互覆盖层（Canvas 模式）：只承载"浮动控件 + 文本编辑框"这类瞬时 XAML 元素。
             卡片本体与选中框仍由 Win2D 自绘，避免逐帧布局开销；本层无 Background，
             空白处不拦截命中，只有子元素（按钮/编辑框）可见时才吃指针。 -->
        <Grid x:Name="CanvasOverlay" Visibility="Collapsed">
            <Grid.Resources>
                <!-- 卡片悬浮控件显隐：与缩放胶囊同源的淡入淡出（0.15s）。Opacity=0 时仍 IsHitTestVisible，
                     故隐藏动画结束再 Collapsed（见 GpuPageView.xaml.cs 的 HideCanvasCardToolbar），避免透明态拦截点击。 -->
                <Storyboard x:Name="CanvasCardToolbarShowAnim">
                    <DoubleAnimation Storyboard.TargetName="CanvasCardToolbar" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                </Storyboard>
                <Storyboard x:Name="CanvasCardToolbarHideAnim">
                    <DoubleAnimation Storyboard.TargetName="CanvasCardToolbar" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                </Storyboard>
                <!-- 连线胶囊：与卡片胶囊同一套淡入淡出（0.15s）。淡出结束时才 Collapsed（放掉命中，
                     避免透明态仍拦截点击）—— 由 CanvasEdgeToolbarHideAnim.Completed 收尾。 -->
                <Storyboard x:Name="CanvasEdgeToolbarShowAnim">
                    <DoubleAnimation Storyboard.TargetName="CanvasEdgeToolbar" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                </Storyboard>
                <Storyboard x:Name="CanvasEdgeToolbarHideAnim">
                    <DoubleAnimation Storyboard.TargetName="CanvasEdgeToolbar" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                </Storyboard>
            </Grid.Resources>

            <!-- 卡片悬浮控件：改为与画笔颜色胶囊同源的胶囊外观（亚克力底 + 大圆角 + 投影）。
                 圆角 / 投影 / 描边画刷均与 PenOptionsCapsule 对齐；固定高度使 CornerRadius=高/2 ⇒ 真胶囊。
                 内部按钮的三态反馈在步骤 2 接管（本步只改容器外观，按钮仍透明）。 -->
            <!-- ⚠ Z 序：本胶囊用 Canvas.ZIndex 提到【不可见输入宿主】CanvasEditBox 之上 —— 它在 XAML 里声明得更晚
                 （更晚 = 更靠上），一旦胶囊因钳制压到卡片矩形上，点击就会被那个 Opacity=0 的编辑框吃掉
                 ⇒ "看得见点不动"。浮层 chrome 必须永远在输入宿主之上。 -->
            <Border x:Name="CanvasCardToolbar" Visibility="Collapsed" Opacity="0"
                    Canvas.ZIndex="10"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Background="{ThemeResource FlyoutPresenterBackground}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="20" Height="42" Padding="6,4"
                    local:ElevationShadow.IsEnabled="True" local:ElevationShadow.Elevation="18">
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <!-- 按钮三态与缩放胶囊 -/+ 完全一致：ButtonNoStateMachineStyle（已提升 App.xaml 全局）+ transparentAtRest
                         （静止并入亚克力胶囊、看不到圆边界）；圆形 32×32 / CornerRadius=16 照抄 -/+ 按钮。
                         刻意不挂 ToolTipService.ToolTip：图标的语义已足够自明，用户不要悬浮气泡（会盖住卡片上沿）。 -->
                    <Button x:Name="CanvasEditButton" Style="{StaticResource ButtonNoStateMachineStyle}" Click="CanvasEditButton_Click"
                            Width="32" Height="32" CornerRadius="16" UseLayoutRounding="True"
                            Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Background="Transparent" BorderThickness="0">
                        <SymbolIcon Symbol="Edit"/>
                    </Button>
                    <!-- 颜色（步骤 3）：与两侧按钮同尺寸同三态；点击行为在步骤 4 接二级颜色胶囊，
                         本步只落按钮本体，故暂不挂 Click（避免留一个空转的事件处理器）。
                         ⚠ 图标用 FontIcon E790（调色盘）而非 SymbolIcon：Symbol 枚举**没有** Color 成员
                         （实测 XamlCompiler WMC0055），语义最近的只有 FontColor（E8D3，A+色条）。
                         E790/E8D3 均已确认存在于 SegoeIcons.ttf 的 cmap；SymbolThemeFontFamily
                         就是符号字体族（实测其在 Microsoft.ui.xaml.resources.19h1.dll 的 XBF 字符串表里
                         取值 = "Segoe Fluent Icons,Segoe MDL2 Assets" ⇒ 与 SymbolIcon 同一套字体、Win10 自动回退 MDL2）。
                         FontSize=20 对齐 SymbolIcon 的默认字号（SymbolIcon 内部 FontSize 默认 20），否则 FontIcon 字号偏小会小一圈。 -->
                    <Button x:Name="CanvasColorButton" Style="{StaticResource ButtonNoStateMachineStyle}" Click="CanvasColorButton_Click"
                            Width="32" Height="32" CornerRadius="16" UseLayoutRounding="True"
                            Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Background="Transparent" BorderThickness="0">
                        <FontIcon Glyph="&#xE790;" FontSize="20"
                                  FontFamily="{ThemeResource SymbolThemeFontFamily}"/>
                    </Button>
                    <!-- 二级颜色：内联展开（替代原下方弹出胶囊）。默认折叠；点颜色按钮时 7 色圆点在颜色按钮右侧展开、撑长胶囊，
                         颜色按钮保留可见（二次点击即可收起）；选完色回到原样。圆点落在 CanvasCardToolbar 内，属同一颗浮层 chrome，不再与卡片重叠。
                         ⚠ 左右间隔必须对称（用户口径：以「颜色按钮 ↔ 首位灰点」的间距为准）：
                            左侧 = 外层 Spacing(4) + 分隔线(宽 1 + 右边距 4) + 内层 Spacing(8) = 17；
                            右侧原本只有外层 Spacing(4) ⇒ 末尾黑点紧贴删除按钮。
                            故在面板右缘补 Margin.Right=13（= 分隔线 1 + 右边距 4 + 内层 Spacing 8），两侧同为 17。 -->
                    <StackPanel x:Name="CanvasColorDotPanel" Visibility="Collapsed" Orientation="Horizontal" Spacing="8"
                                VerticalAlignment="Center" Margin="0,0,13,0">
                        <Border Width="1" Margin="0,3,4,3" Background="{ThemeResource CardStrokeColorDefaultBrush}"/>
                        <!-- 首位 = 卡片边框默认灰 #8A8F98，与后 6 色完全同一套逻辑（静止/悬浮/按下都是自身色，选中放大）。 -->
                        <Button x:Name="CanvasColorDefaultBtn" Click="CanvasColorDot_Click" Tag="#8A8F98" Width="16" Height="16" MinWidth="16" MinHeight="16" VerticalAlignment="Center" CornerRadius="8" Background="#8A8F98" BorderThickness="2" BorderBrush="Transparent" Padding="0">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#8A8F98"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#8A8F98"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent"/>
                            </Button.Resources>
                        </Button>
                        <Button x:Name="CanvasColorBlueBtn" Click="CanvasColorDot_Click" Tag="#2E6FE0" Width="16" Height="16" MinWidth="16" MinHeight="16" VerticalAlignment="Center" CornerRadius="8" Background="#2E6FE0" BorderThickness="2" BorderBrush="Transparent" Padding="0">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#2E6FE0"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#2E6FE0"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent"/>
                            </Button.Resources>
                        </Button>
                        <Button x:Name="CanvasColorCyanBtn" Click="CanvasColorDot_Click" Tag="#16B1C4" Width="16" Height="16" MinWidth="16" MinHeight="16" VerticalAlignment="Center" CornerRadius="8" Background="#16B1C4" BorderThickness="2" BorderBrush="Transparent" Padding="0">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#16B1C4"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#16B1C4"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent"/>
                            </Button.Resources>
                        </Button>
                        <Button x:Name="CanvasColorGreenBtn" Click="CanvasColorDot_Click" Tag="#2FA84F" Width="16" Height="16" MinWidth="16" MinHeight="16" VerticalAlignment="Center" CornerRadius="8" Background="#2FA84F" BorderThickness="2" BorderBrush="Transparent" Padding="0">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#2FA84F"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#2FA84F"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent"/>
                            </Button.Resources>
                        </Button>
                        <Button x:Name="CanvasColorYellowBtn" Click="CanvasColorDot_Click" Tag="#F2C200" Width="16" Height="16" MinWidth="16" MinHeight="16" VerticalAlignment="Center" CornerRadius="8" Background="#F2C200" BorderThickness="2" BorderBrush="Transparent" Padding="0">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#F2C200"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#F2C200"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent"/>
                            </Button.Resources>
                        </Button>
                        <Button x:Name="CanvasColorRedBtn" Click="CanvasColorDot_Click" Tag="#E5393B" Width="16" Height="16" MinWidth="16" MinHeight="16" VerticalAlignment="Center" CornerRadius="8" Background="#E5393B" BorderThickness="2" BorderBrush="Transparent" Padding="0">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#E5393B"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#E5393B"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent"/>
                            </Button.Resources>
                        </Button>
                        <Button x:Name="CanvasColorBlackBtn" Click="CanvasColorDot_Click" Tag="#000000" Width="16" Height="16" MinWidth="16" MinHeight="16" VerticalAlignment="Center" CornerRadius="8" Background="Black" BorderThickness="2" BorderBrush="Transparent" Padding="0">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Black"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Black"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent"/>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                    <Button x:Name="CanvasDeleteButton" Style="{StaticResource ButtonNoStateMachineStyle}" Click="CanvasDeleteButton_Click"
                            Width="32" Height="32" CornerRadius="16" UseLayoutRounding="True"
                            Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Background="Transparent" BorderThickness="0">
                        <SymbolIcon Symbol="Delete"/>
                    </Button>
                </StackPanel>
            </Border>

            <!-- 连线悬浮控件：与卡片胶囊【完全同源】（亚克力底 + 大圆角 + 投影 + 同一套按钮三态），
                 让"选中卡片"与"选中连线"两处浮层的观感与手感一致。
                 两个二级面板（箭头样式 / 颜色）默认折叠，点各自按钮在其右侧内联展开、二者互斥（同一时刻只开一个）；
                 选完即收起并回到窄态 —— 与卡片胶囊的二级颜色胶囊同一套交互语言。
                 ⚠ 与卡片胶囊一样刻意【不挂】ToolTipService.ToolTip：图标语义自明，气泡会盖住连线上方区域。
                 ⚠ 左右间距对称（与卡片胶囊同一口径，以"按钮 ↔ 面板首个元素"的间距为准）：
                    箭头面板：左侧 = 外层 Spacing(4) + 分隔线(1 + 右距 4) + 内层 Spacing(4) = 13 ⇒ 右缘补 Margin.Right=9（+外层 4 = 13）；
                    颜色面板：左侧 = 外层 Spacing(4) + 分隔线(1 + 右距 4) + 内层 Spacing(8) = 17 ⇒ 右缘补 Margin.Right=13（+外层 4 = 17）。 -->
            <!-- 同卡片胶囊：Canvas.ZIndex 提到不可见输入宿主之上（理由见上）。 -->
            <Border x:Name="CanvasEdgeToolbar" Visibility="Collapsed" Opacity="0"
                    Canvas.ZIndex="10"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Background="{ThemeResource FlyoutPresenterBackground}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="20" Height="42" Padding="6,4"
                    local:ElevationShadow.IsEnabled="True" local:ElevationShadow.Elevation="18">
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <!-- 箭头样式：按钮本体【显示当前样式】（无=横线 / 单=横线+右箭头 / 双=横线+双箭头），点击在右侧展开三选。
                         全部自绘矢量（XAML Path），不依赖 Segoe 字形，规避描边不一致 / 拼接缝 / 占位不等。 -->
                    <Button x:Name="CanvasEdgeArrowButton" Style="{StaticResource ButtonNoStateMachineStyle}" Click="CanvasEdgeArrowButton_Click"
                            Width="32" Height="32" CornerRadius="16" UseLayoutRounding="True"
                            Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Background="Transparent" BorderThickness="0">
                        <!-- 当前箭头样式（三态互斥）：none=横线 / single=横线+右箭头 / both=横线+双箭头。
                             【完全照抄缩放胶囊 -/+ 的方法，两条缺一不可】：
                             ① 描边宽恒定 2【物理像素】——XAML 不写死 DIP，由
                                ApplyCanvasEdgeArrowGlyphStrokeThickness() 按 2 / RasterizationScale 写入；
                             ② 坐标一律取 4 DIP 的倍数（8/12/16/20/24），线心 y=16 ⇒ 100/125/150/175/200% 下
                                中心与描边两边都落整设备像素 ⇒ 直线上下无软边、上下对称。
                             每个符号【单一描边 Path】(Stretch=None + Flat 端帽)，箭头用 45° 开口箭头(chevron)，
                             斜边虚边可接受。几何 bbox 中心均为 (16,16) ⇒ 三态天然对齐。 -->
                        <Grid>
                            <Path x:Name="CanvasEdgeArrowNoneGlyph" Width="32" Height="32" Stretch="None"
                                  Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="2"
                                  StrokeStartLineCap="Flat" StrokeEndLineCap="Flat"
                                  Data="M8,16 L24,16" Visibility="Collapsed" IsHitTestVisible="False"/>
                            <Path x:Name="CanvasEdgeArrowSingleGlyph" Width="32" Height="32" Stretch="None"
                                  Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="2"
                                  StrokeStartLineCap="Flat" StrokeEndLineCap="Flat"
                                  Data="M8,16 L20,16 M20,12 L24,16 L20,20" Visibility="Collapsed" IsHitTestVisible="False"/>
                            <Path x:Name="CanvasEdgeArrowBothGlyph" Width="32" Height="32" Stretch="None"
                                  Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="2"
                                  StrokeStartLineCap="Flat" StrokeEndLineCap="Flat"
                                  Data="M12,16 L20,16 M20,12 L24,16 L20,20 M12,12 L8,16 L12,20" Visibility="Collapsed" IsHitTestVisible="False"/>
                        </Grid>
                    </Button>
                    <!-- 二级箭头：内联展开（默认折叠）。选中态用【不透明度】表达（当前 1.0 / 其余 0.4），
                         由 RefreshEdgeArrowButtons 按选中连线的实际两端写。 -->
                    <StackPanel x:Name="CanvasEdgeArrowPanel" Visibility="Collapsed" Orientation="Horizontal" Spacing="4"
                                VerticalAlignment="Center" Margin="0,0,9,0">
                        <Border Width="1" Margin="0,3,4,3" Background="{ThemeResource CardStrokeColorDefaultBrush}"/>
                        <Button x:Name="CanvasEdgeArrowNoneBtn" Tag="none" Style="{StaticResource ButtonNoStateMachineStyle}" Click="CanvasEdgeArrowOption_Click"
                                Width="32" Height="32" CornerRadius="16" UseLayoutRounding="True"
                                Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Background="Transparent" BorderThickness="0">
                            <Path Width="32" Height="32" Stretch="None" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="2"
                                  StrokeStartLineCap="Flat" StrokeEndLineCap="Flat" Data="M8,16 L24,16" IsHitTestVisible="False"/>
                        </Button>
                        <Button x:Name="CanvasEdgeArrowSingleBtn" Tag="single" Style="{StaticResource ButtonNoStateMachineStyle}" Click="CanvasEdgeArrowOption_Click"
                                Width="32" Height="32" CornerRadius="16" UseLayoutRounding="True"
                                Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Background="Transparent" BorderThickness="0">
                            <Path Width="32" Height="32" Stretch="None" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="2"
                                  StrokeStartLineCap="Flat" StrokeEndLineCap="Flat"
                                  Data="M8,16 L20,16 M20,12 L24,16 L20,20" IsHitTestVisible="False"/>
                        </Button>
                        <Button x:Name="CanvasEdgeArrowBothBtn" Tag="both" Style="{StaticResource ButtonNoStateMachineStyle}" Click="CanvasEdgeArrowOption_Click"
                                Width="32" Height="32" CornerRadius="16" UseLayoutRounding="True"
                                Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Background="Transparent" BorderThickness="0">
                            <Path Width="32" Height="32" Stretch="None" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="2"
                                  StrokeStartLineCap="Flat" StrokeEndLineCap="Flat"
                                  Data="M12,16 L20,16 M20,12 L24,16 L20,20 M12,12 L8,16 L12,20" IsHitTestVisible="False"/>
                        </Button>
                    </StackPanel>
                    <!-- 颜色：与卡片胶囊同一个调色盘图标（FontIcon E790；Symbol 枚举无 Color 成员）。 -->
                    <Button x:Name="CanvasEdgeColorButton" Style="{StaticResource ButtonNoStateMachineStyle}" Click="CanvasEdgeColorButton_Click"
                            Width="32" Height="32" CornerRadius="16" UseLayoutRounding="True"
                            Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Background="Transparent" BorderThickness="0">
                        <FontIcon Glyph="&#xE790;" FontSize="20"
                                  FontFamily="{ThemeResource SymbolThemeFontFamily}"/>
                    </Button>
                    <!-- 二级颜色：7 色与卡片胶囊【同一套色值】，且一视同仁 —— 首位灰只是"其中一色"，
                         不再承担"恢复默认"的特殊语义（连线未着色时本就以默认灰绘制，见 DrawCanvasEdge 的 CanvasEdgeColor）。
                         底色档照抄卡片：逐按钮在 XAML 解析期声明（运行时写 Resources 会在主题切换时闪退）。 -->
                    <StackPanel x:Name="CanvasEdgeColorDotPanel" Visibility="Collapsed" Orientation="Horizontal" Spacing="8"
                                VerticalAlignment="Center" Margin="0,0,13,0">
                        <Border Width="1" Margin="0,3,4,3" Background="{ThemeResource CardStrokeColorDefaultBrush}"/>
                        <Button x:Name="CanvasEdgeColorGrayBtn" Click="CanvasEdgeColorDot_Click" Tag="#8A8F98" Width="16" Height="16" MinWidth="16" MinHeight="16" VerticalAlignment="Center" CornerRadius="8" Background="#8A8F98" BorderThickness="2" BorderBrush="Transparent" Padding="0">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#8A8F98"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#8A8F98"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent"/>
                            </Button.Resources>
                        </Button>
                        <Button x:Name="CanvasEdgeColorBlueBtn" Click="CanvasEdgeColorDot_Click" Tag="#2E6FE0" Width="16" Height="16" MinWidth="16" MinHeight="16" VerticalAlignment="Center" CornerRadius="8" Background="#2E6FE0" BorderThickness="2" BorderBrush="Transparent" Padding="0">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#2E6FE0"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#2E6FE0"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent"/>
                            </Button.Resources>
                        </Button>
                        <Button x:Name="CanvasEdgeColorCyanBtn" Click="CanvasEdgeColorDot_Click" Tag="#16B1C4" Width="16" Height="16" MinWidth="16" MinHeight="16" VerticalAlignment="Center" CornerRadius="8" Background="#16B1C4" BorderThickness="2" BorderBrush="Transparent" Padding="0">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#16B1C4"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#16B1C4"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent"/>
                            </Button.Resources>
                        </Button>
                        <Button x:Name="CanvasEdgeColorGreenBtn" Click="CanvasEdgeColorDot_Click" Tag="#2FA84F" Width="16" Height="16" MinWidth="16" MinHeight="16" VerticalAlignment="Center" CornerRadius="8" Background="#2FA84F" BorderThickness="2" BorderBrush="Transparent" Padding="0">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#2FA84F"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#2FA84F"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent"/>
                            </Button.Resources>
                        </Button>
                        <Button x:Name="CanvasEdgeColorYellowBtn" Click="CanvasEdgeColorDot_Click" Tag="#F2C200" Width="16" Height="16" MinWidth="16" MinHeight="16" VerticalAlignment="Center" CornerRadius="8" Background="#F2C200" BorderThickness="2" BorderBrush="Transparent" Padding="0">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#F2C200"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#F2C200"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent"/>
                            </Button.Resources>
                        </Button>
                        <Button x:Name="CanvasEdgeColorRedBtn" Click="CanvasEdgeColorDot_Click" Tag="#E5393B" Width="16" Height="16" MinWidth="16" MinHeight="16" VerticalAlignment="Center" CornerRadius="8" Background="#E5393B" BorderThickness="2" BorderBrush="Transparent" Padding="0">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#E5393B"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#E5393B"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent"/>
                            </Button.Resources>
                        </Button>
                        <Button x:Name="CanvasEdgeColorBlackBtn" Click="CanvasEdgeColorDot_Click" Tag="#000000" Width="16" Height="16" MinWidth="16" MinHeight="16" VerticalAlignment="Center" CornerRadius="8" Background="Black" BorderThickness="2" BorderBrush="Transparent" Padding="0">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Black"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Black"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent"/>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                    <Button x:Name="CanvasEdgeDeleteButton" Style="{StaticResource ButtonNoStateMachineStyle}" Click="CanvasEdgeDeleteButton_Click"
                            Width="32" Height="32" CornerRadius="16" UseLayoutRounding="True"
                            Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Background="Transparent" BorderThickness="0">
                        <SymbolIcon Symbol="Delete"/>
                    </Button>
                </StackPanel>
            </Border>

            <!-- 卡片文本编辑框：【不可见输入宿主】(Opacity=0)。三态（阅读/选中/编辑）文字一律由 Win2D
                 的 CanvasTextLayout 绘制 ⇒ 不存在"两个引擎排版口径不同"导致的两态偏移（这是此前编辑态字体
                 小幅位移的根因）。RichEditBox 仅负责接收键盘/指针/IME 输入、维护 TOM 文档与光标选区，
                 可见文字/光标/选区/滚动条全部由 Win2D 按其自身 layout 绘制。
                 必须仍是 RichEditBox 而非 TextBox：需要 ITextParagraphFormat.SetLineSpacing 把行距锁到
                 Win2D 实测值（仅供"点击落光标"的命中映射对齐，不影响可见渲染，因为渲染已交给 Win2D）。
                 代价是它天生富文本控件，故关闭格式化快捷键、复制/粘贴按纯文本，保持卡片"纯文本"语义。
                 边框由 Win2D(DrawCanvasCard) 在编辑态按【选中】强调色绘制，不再需要上层 CanvasEditFrame。
                 ⚠ 刻意【不再】局部锁 RequestedTheme="Light"：WinUI 内置的文本右键菜单（剪切/复制/粘贴/全选）
                 **镜像它所依附的文本控件的主题**，锁浅色会把深色模式下的菜单文字锁成黑色，而菜单底板走弹层
                 自己的深色档 ⇒ 深底黑字不可读（用户报告）；去掉锁之后又在浅色模式下变成白底白字 —— 底板与
                 文字来自两套主题，怎么配都不对。并且它是独立弹层，弹出即夺走焦点 → CanvasEditBox_LostFocus
                 → EndCanvasEdit(commit) ⇒ "右键后拖选消失"，菜单项还作用在已折叠的隐形宿主上（用户报告）。
                 ⇒ 现改为【自绘非聚焦菜单】：在 **ContextMenuOpening** 里 Handled=true 抑制系统菜单，改由覆盖层内的
                 CanvasEditContextMenu 承担（见下方）。
                 ⚠ 拦截入口只能是 ContextMenuOpening，**不是 ContextRequested**：RichEditBox 弹出内置菜单走的是
                 控件自己的 ContextMenuOpening（实测 ContextRequested 里 Handled=true 完全无效，菜单照出）。
                 也不要挂 ContextFlyout —— 那仍是弹层，一样抢焦点。
                 Opacity="0" 让它可见性完全交给 Win2D；Visibility 在编辑期切到 Visible、退出编辑 Collapsed。 -->
            <local:CanvasEditHostBox x:Name="CanvasEditBox" Visibility="Collapsed" Opacity="0"
                     HorizontalAlignment="Left" VerticalAlignment="Top"
                     RenderTransformOrigin="0,0"
                     FontFamily="Segoe UI"
                     BorderThickness="0"
                     UseSystemFocusVisuals="False"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalContentAlignment="Top" HorizontalContentAlignment="Left"
                     IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
                     DisabledFormattingAccelerators="All"
                     ClipboardCopyFormat="PlainText"
                     ScrollViewer.VerticalScrollBarVisibility="Hidden"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ContextMenuOpening="CanvasEditBox_ContextMenuOpening"
                     LostFocus="CanvasEditBox_LostFocus"
                     TextChanged="CanvasEditBox_TextChanged"
                     PreviewKeyDown="CanvasEditBox_PreviewKeyDown"
                     KeyDown="CanvasEditBox_KeyDown"
                     PointerExited="CanvasEditBox_PointerExited"
                     Paste="CanvasEditBox_Paste">
                <!-- 把编辑框聚焦/悬停态的自带"边框厚度"主题值压成 0：Fluent 文本框聚焦时会临时把
                     内部 BorderElement 的边框改成【底部 2px】并染成 accent 蓝。编辑框现已 Opacity=0 不可见，
                     此压平仅为稳妥，避免任何漏出（虽然不可见，但命中/输入仍由它承担）。 -->
                <local:CanvasEditHostBox.Resources>
                    <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                    <Thickness x:Key="TextControlBorderThemeThicknessPointerOver">0</Thickness>
                </local:CanvasEditHostBox.Resources>
            </local:CanvasEditHostBox>

            <!-- ===== 编辑态文本右键菜单（自绘，非弹层）=====
                 承接 CanvasEditBox 的 ContextMenuOpening（那边 Handled=true 抑制系统菜单，本菜单由代码摆位）。为什么不用系统菜单：
                 ① 主题错配 —— 内置文本菜单镜像【文本控件】的主题，而底板走弹层自己的主题，深色下"深底黑字"、
                    去掉局部浅色锁后又变成"白底白字"（两次用户报告都是这个机制）；
                 ② 抢焦点 —— 系统菜单是独立弹层，弹出即把焦点从编辑框拿走 → CanvasEditBox_LostFocus
                    → EndCanvasEdit(commit) ⇒ 右键后拖选当场消失，且菜单项作用在已折叠的隐形宿主上，
                    看起来"全选无效"。
                 ⇒ 本菜单刻意全是【非聚焦】元素：每一行是 Grid 而不是 Button（Button 按下会拿焦点），
                    只走 PointerPressed ⇒ 编辑框全程持有焦点，选区/光标/IME 状态零变动。
                 底板/描边/圆角/投影与卡片胶囊同一套主题资源，深浅主题自动跟随；悬停底色复用 App.xaml 里
                 「…」溢出菜单那一档（MenuFlyoutItemBackgroundPointerOver），不新造颜色。
                 ⚠ Z 序：菜单必须在【两张胶囊之上、且压住不可见输入宿主】，故取更高的 ZIndex。 -->
            <Border x:Name="CanvasEditContextMenu" Visibility="Collapsed"
                    Canvas.ZIndex="20"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Background="{ThemeResource FlyoutPresenterBackground}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="4"
                    local:ElevationShadow.IsEnabled="True" local:ElevationShadow.Elevation="18"
                    PointerPressed="CanvasEditContextMenu_PointerPressed">
                <StackPanel Width="184">
                    <Grid x:Name="CanvasEditMenuCut" Tag="cut" Height="32" Background="Transparent"
                          PointerEntered="CanvasEditMenuItem_PointerEntered"
                          PointerExited="CanvasEditMenuItem_PointerExited"
                          PointerPressed="CanvasEditMenuItem_PointerPressed">
                        <Border Background="{ThemeResource MenuFlyoutItemBackgroundPointerOver}" CornerRadius="4"
                                Opacity="0" IsHitTestVisible="False"/>
                        <Grid Padding="8,0" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8C6;" FontSize="14" VerticalAlignment="Center"
                                      FontFamily="{ThemeResource SymbolThemeFontFamily}"/>
                            <TextBlock x:Name="CanvasEditMenuCutText" Grid.Column="1" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Ctrl+X" FontSize="12" Opacity="0.55" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                    <Grid x:Name="CanvasEditMenuCopy" Tag="copy" Height="32" Background="Transparent"
                          PointerEntered="CanvasEditMenuItem_PointerEntered"
                          PointerExited="CanvasEditMenuItem_PointerExited"
                          PointerPressed="CanvasEditMenuItem_PointerPressed">
                        <Border Background="{ThemeResource MenuFlyoutItemBackgroundPointerOver}" CornerRadius="4"
                                Opacity="0" IsHitTestVisible="False"/>
                        <Grid Padding="8,0" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8C8;" FontSize="14" VerticalAlignment="Center"
                                      FontFamily="{ThemeResource SymbolThemeFontFamily}"/>
                            <TextBlock x:Name="CanvasEditMenuCopyText" Grid.Column="1" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Ctrl+C" FontSize="12" Opacity="0.55" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                    <Grid x:Name="CanvasEditMenuPaste" Tag="paste" Height="32" Background="Transparent"
                          PointerEntered="CanvasEditMenuItem_PointerEntered"
                          PointerExited="CanvasEditMenuItem_PointerExited"
                          PointerPressed="CanvasEditMenuItem_PointerPressed">
                        <Border Background="{ThemeResource MenuFlyoutItemBackgroundPointerOver}" CornerRadius="4"
                                Opacity="0" IsHitTestVisible="False"/>
                        <Grid Padding="8,0" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE77F;" FontSize="14" VerticalAlignment="Center"
                                      FontFamily="{ThemeResource SymbolThemeFontFamily}"/>
                            <TextBlock x:Name="CanvasEditMenuPasteText" Grid.Column="1" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Ctrl+V" FontSize="12" Opacity="0.55" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                    <Border Height="1" Margin="8,4" Opacity="0.6"
                            Background="{ThemeResource CardStrokeColorDefaultBrush}"/>
                    <!-- ===== Markdown 快捷格式组 =====
                         作用对象是【编辑框当前选区】（与剪切/复制同一套选区，不另存状态）。点一下把选区用对应标记
                         包起来；再点一下（同一标记）把它拆掉 ⇒ 一组行既是"加"也是"减"，无需额外的"清除格式"。
                         左列用 B / I / S / <> / 色块做图（语言无关、无字体缺字风险），右列用等宽字直接标出
                         实际插入的字符 —— 既是提示也是语法教学，比硬造快捷键提示诚实（这几项没有快捷键）。
                         ⚠ 右列对齐（用户报告"歪歪扭扭"）：Auto 列会把宽度不同的标记各自右对齐 ⇒ 左右参差。
                           故固定 Width="22" + TextAlignment="Center" 管水平；竖直再按【字形墨迹位置】逐个微调
                           TranslateTransform（等宽字体里 * 和 ` 的墨迹偏上、~ 和 = 偏下，文字块居中 ≠ 墨迹居中）：
                           `**`/`*` +0.8、`~~`/`==` -2、`` ` ` `` +2.4（单位 DIP，按屏截图实测定标）。
                           改字号/换字体后这些偏移要重测，别凭感觉调。 -->
                    <Grid x:Name="CanvasEditMenuBold" Tag="bold" Height="32" Background="Transparent"
                          PointerEntered="CanvasEditMenuItem_PointerEntered"
                          PointerExited="CanvasEditMenuItem_PointerExited"
                          PointerPressed="CanvasEditMenuItem_PointerPressed">
                        <Border Background="{ThemeResource MenuFlyoutItemBackgroundPointerOver}" CornerRadius="4"
                                Opacity="0" IsHitTestVisible="False"/>
                        <Grid Padding="8,0" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="22"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="B" FontSize="13" FontWeight="Bold" Opacity="0.85"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CanvasEditMenuBoldText" Grid.Column="1" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="**" FontSize="12" Opacity="0.45"
                                       FontFamily="Consolas" VerticalAlignment="Center" TextAlignment="Center">
                                <TextBlock.RenderTransform><TranslateTransform Y="0.8"/></TextBlock.RenderTransform>
                            </TextBlock>
                        </Grid>
                    </Grid>
                    <Grid x:Name="CanvasEditMenuItalic" Tag="italic" Height="32" Background="Transparent"
                          PointerEntered="CanvasEditMenuItem_PointerEntered"
                          PointerExited="CanvasEditMenuItem_PointerExited"
                          PointerPressed="CanvasEditMenuItem_PointerPressed">
                        <Border Background="{ThemeResource MenuFlyoutItemBackgroundPointerOver}" CornerRadius="4"
                                Opacity="0" IsHitTestVisible="False"/>
                        <Grid Padding="8,0" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="22"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="I" FontSize="14" FontStyle="Italic" Opacity="0.85"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CanvasEditMenuItalicText" Grid.Column="1" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="*" FontSize="12" Opacity="0.45"
                                       FontFamily="Consolas" VerticalAlignment="Center" TextAlignment="Center">
                                <TextBlock.RenderTransform><TranslateTransform Y="0.8"/></TextBlock.RenderTransform>
                            </TextBlock>
                        </Grid>
                    </Grid>
                    <Grid x:Name="CanvasEditMenuStrike" Tag="strike" Height="32" Background="Transparent"
                          PointerEntered="CanvasEditMenuItem_PointerEntered"
                          PointerExited="CanvasEditMenuItem_PointerExited"
                          PointerPressed="CanvasEditMenuItem_PointerPressed">
                        <Border Background="{ThemeResource MenuFlyoutItemBackgroundPointerOver}" CornerRadius="4"
                                Opacity="0" IsHitTestVisible="False"/>
                        <Grid Padding="8,0" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="22"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="S" FontSize="13" TextDecorations="Strikethrough" Opacity="0.85"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CanvasEditMenuStrikeText" Grid.Column="1" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="~~" FontSize="12" Opacity="0.45"
                                       FontFamily="Consolas" VerticalAlignment="Center" TextAlignment="Center">
                                <TextBlock.RenderTransform><TranslateTransform Y="-2"/></TextBlock.RenderTransform>
                            </TextBlock>
                        </Grid>
                    </Grid>
                    <Grid x:Name="CanvasEditMenuCode" Tag="code" Height="32" Background="Transparent"
                          PointerEntered="CanvasEditMenuItem_PointerEntered"
                          PointerExited="CanvasEditMenuItem_PointerExited"
                          PointerPressed="CanvasEditMenuItem_PointerPressed">
                        <Border Background="{ThemeResource MenuFlyoutItemBackgroundPointerOver}" CornerRadius="4"
                                Opacity="0" IsHitTestVisible="False"/>
                        <Grid Padding="8,0" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="22"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&lt;&gt;" FontSize="12" FontFamily="Consolas" Opacity="0.85"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CanvasEditMenuCodeText" Grid.Column="1" FontSize="13" VerticalAlignment="Center"/>
                            <!-- 右列必须显示【真的标记】反引号，不能拿方框代替：方框会被读成 "[]"，
                                 而且与高亮那个色块只差颜色 ⇒ 两个图标分不清（用户报告）。
                                 两个反引号要【紧挨着】—— 中间夹空格会与其它行（`**` `~~` `==` 都紧贴）不成一体。 -->
                            <TextBlock Grid.Column="2" Text="``" FontSize="12" Opacity="0.6"
                                       FontFamily="Consolas" VerticalAlignment="Center" TextAlignment="Center">
                                <TextBlock.RenderTransform><TranslateTransform Y="2.4"/></TextBlock.RenderTransform>
                            </TextBlock>
                        </Grid>
                    </Grid>
                    <Grid x:Name="CanvasEditMenuHighlight" Tag="highlight" Height="32" Background="Transparent"
                          PointerEntered="CanvasEditMenuItem_PointerEntered"
                          PointerExited="CanvasEditMenuItem_PointerExited"
                          PointerPressed="CanvasEditMenuItem_PointerPressed">
                        <Border Background="{ThemeResource MenuFlyoutItemBackgroundPointerOver}" CornerRadius="4"
                                Opacity="0" IsHitTestVisible="False"/>
                        <Grid Padding="8,0" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="22"/>
                            </Grid.ColumnDefinitions>
                            <!-- 色块颜色由代码从 CanvasMarkdownHighlightBackdrop 直接取（不在这里写死十六进制），
                                 保证"菜单里看到的黄"与"卡片里高亮的黄"永远是同一个常量。 -->
                            <Border x:Name="CanvasEditMenuHighlightSwatch"
                                    Width="13" Height="10" CornerRadius="2"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CanvasEditMenuHighlightText" Grid.Column="1" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="==" FontSize="12" Opacity="0.45"
                                       FontFamily="Consolas" VerticalAlignment="Center" TextAlignment="Center">
                                <TextBlock.RenderTransform><TranslateTransform Y="-2"/></TextBlock.RenderTransform>
                            </TextBlock>
                        </Grid>
                    </Grid>
                    <Border Height="1" Margin="8,4" Opacity="0.6"
                            Background="{ThemeResource CardStrokeColorDefaultBrush}"/>
                    <Grid x:Name="CanvasEditMenuSelectAll" Tag="selectall" Height="32" Background="Transparent"
                          PointerEntered="CanvasEditMenuItem_PointerEntered"
                          PointerExited="CanvasEditMenuItem_PointerExited"
                          PointerPressed="CanvasEditMenuItem_PointerPressed">
                        <Border Background="{ThemeResource MenuFlyoutItemBackgroundPointerOver}" CornerRadius="4"
                                Opacity="0" IsHitTestVisible="False"/>
                        <Grid Padding="8,0" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- 全选图标：Segoe E71A（空心方框），与剪切/复制/粘贴同源。
                                 ✅ E71A 在 Segoe Fluent Icons 与 Segoe MDL2 Assets 里【都有】⇒ Win10 不会缺字；
                                    造型随字体版本略有差异（Win11/Fluent 圆角、Win10/MDL2 直角），但都是空心框。
                                 ⛔ 别用 F1A2（四角括号）：MDL2 无此码位，Win10 会渲染成 tofu 空心方块。 -->
                            <FontIcon Glyph="&#xE71A;" FontSize="14" VerticalAlignment="Center"
                                      FontFamily="{ThemeResource SymbolThemeFontFamily}"/>
                            <TextBlock x:Name="CanvasEditMenuSelectAllText" Grid.Column="1" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Ctrl+A" FontSize="12" Opacity="0.55" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>

        </Grid>

    </Grid>
</UserControl>
