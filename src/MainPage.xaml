<?xml version="1.0" encoding="utf-8" ?>

<Page

    x:Class="Glance.MainPage"

    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"

    xmlns:local="using:Glance"

    xmlns:services="using:Glance.Services"

    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

    mc:Ignorable="d"

    Background="Transparent"

    KeyboardAcceleratorPlacementMode="Hidden">



    <Page.Resources>

        <!-- 【共用】ToggleButton 视觉状态机接管样式 —— 已用于：顶部工具栏「阅读模式」按钮、

             侧边栏「缩略图 / 书签 / 大纲」三模式切换键（共 4 颗）。

             外观与 DefaultToggleButtonStyle（generic.xaml:27811-28013）完全逐行等价 ——

             那 12 个 setter 与模板正文都逐字抄自基类（含 HorizontalAlignment=Left / VerticalAlignment=Center，

             见 generic.xaml:27818-27819），唯一的区别是【不带 VisualStateGroups / BackgroundTransition】：

             原生 CommonStates 那套 Storyboard 直接不存在了，谁也抢不走模板根的四个视觉属性，

             颜色改由 Services/ToggleButtonVisualOverride.cs 独占写入（取值与状态表同源）。

             这里刻意【不用 BasedOn】而是把基类的 setter 逐条抄进来：派生样式能否覆盖基类 Template

             属于未记载行为，自包含样式没有这个假设，外观也不依赖基类任何一个 setter 还在不在。

             改这里前先对着 generic.xaml:27812-27825 核对一遍。 -->

        <Style x:Key="ToggleButtonNoStateMachineStyle" TargetType="ToggleButton">

            <Setter Property="Background" Value="{ThemeResource ToggleButtonBackground}" />

            <Setter Property="BackgroundSizing" Value="InnerBorderEdge" />

            <Setter Property="Foreground" Value="{ThemeResource ToggleButtonForeground}" />

            <Setter Property="BorderBrush" Value="{ThemeResource ToggleButtonBorderBrush}" />

            <Setter Property="BorderThickness" Value="{ThemeResource ToggleButtonBorderThemeThickness}" />

            <Setter Property="Padding" Value="{StaticResource ButtonPadding}" />

            <Setter Property="HorizontalAlignment" Value="Left" />

            <Setter Property="VerticalAlignment" Value="Center" />

            <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />

            <Setter Property="FontWeight" Value="Normal" />

            <Setter Property="FontSize" Value="{ThemeResource ControlContentThemeFontSize}" />

            <Setter Property="UseSystemFocusVisuals" Value="{StaticResource UseSystemFocusVisuals}" />

            <Setter Property="FocusVisualMargin" Value="-3" />

            <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ToggleButton">

                        <ContentPresenter x:Name="ContentPresenter"

                                          Background="{TemplateBinding Background}"

                                          Foreground="{TemplateBinding Foreground}"

                                          BackgroundSizing="{TemplateBinding BackgroundSizing}"

                                          BorderBrush="{TemplateBinding BorderBrush}"

                                          BorderThickness="{TemplateBinding BorderThickness}"

                                          Content="{TemplateBinding Content}"

                                          ContentTemplate="{TemplateBinding ContentTemplate}"

                                          ContentTransitions="{TemplateBinding ContentTransitions}"

                                          CornerRadius="{TemplateBinding CornerRadius}"

                                          Padding="{TemplateBinding Padding}"

                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"

                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"

                                          AutomationProperties.AccessibilityView="Raw"/>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>



        <!-- 功能按钮（非选中态）专属无状态机样式：与 ToggleButtonNoStateMachineStyle 同源，

             复刻 DefaultButtonStyle 模板但去掉 VisualStateGroups 与 BackgroundTransition，

             把颜色独占权交给 ButtonVisualOverride（坐标几何 hover + 写 ToggleButton* 未选中三档；Button* 键深色下取错主题档已禁用，见 ButtonVisualOverride.cs）。

             ⚠ 仅用于标准外观按钮；颜色胶囊 / 线宽胶囊 / 透明 pill / 浮层 / 书签模板内按钮 不套此样式。 -->

        <Style x:Key="ButtonNoStateMachineStyle" TargetType="Button">

            <Setter Property="Background" Value="{ThemeResource ButtonBackground}" />

            <Setter Property="BackgroundSizing" Value="InnerBorderEdge" />

            <Setter Property="Foreground" Value="{ThemeResource ButtonForeground}" />

            <Setter Property="BorderBrush" Value="{ThemeResource ButtonBorderBrush}" />

            <Setter Property="BorderThickness" Value="{ThemeResource ButtonBorderThemeThickness}" />

            <Setter Property="Padding" Value="{StaticResource ButtonPadding}" />

            <Setter Property="HorizontalAlignment" Value="Left" />

            <Setter Property="VerticalAlignment" Value="Center" />

            <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />

            <Setter Property="FontWeight" Value="Normal" />

            <Setter Property="FontSize" Value="{ThemeResource ControlContentThemeFontSize}" />

            <Setter Property="UseSystemFocusVisuals" Value="{StaticResource UseSystemFocusVisuals}" />

            <Setter Property="FocusVisualMargin" Value="-3" />

            <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <ContentPresenter x:Name="ContentPresenter"

                                          Background="{TemplateBinding Background}"

                                          Foreground="{TemplateBinding Foreground}"

                                          BackgroundSizing="{TemplateBinding BackgroundSizing}"

                                          BorderBrush="{TemplateBinding BorderBrush}"

                                          BorderThickness="{TemplateBinding BorderThickness}"

                                          Content="{TemplateBinding Content}"

                                          ContentTemplate="{TemplateBinding ContentTemplate}"

                                          ContentTransitions="{TemplateBinding ContentTransitions}"

                                          CornerRadius="{TemplateBinding CornerRadius}"

                                          Padding="{TemplateBinding Padding}"

                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"

                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"

                                          AutomationProperties.AccessibilityView="Raw"/>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>



        <!-- 缩放预设浮层 8 颗：同机制，但【逐条抄 ZoomFlyoutItemStyle 的全部 setter】再换无状态机模板。

             ⚠ 任何 NoStateMachineStyle 都必须「基样式 setter + Template 全抄，仅删状态机」——

               只抄 Template 会丢 Padding / CornerRadius / Foreground 而让外观变形（09-29 实测踩过）。 -->
        <Style x:Key="ZoomFlyoutItemNoStateMachineStyle" TargetType="Button">
            <Setter Property="IsTabStop" Value="False"/>
            <!-- 上下不对称 Padding（上 7 / 下 9，总高不变）：抵消字体行盒下降部预留，把居中文字整体上移 1px（10-02 精修）。 -->
            <Setter Property="Padding" Value="16,7,16,9"/>
            <!-- 居中对齐 + 字号与项目其它按钮同源（字体键必须用 ContentControlThemeFontFamily，
                 不是 ControlContentThemeFontFamily —— 后者在本 WinUI 版本不存在，会 XamlParseException 崩启动，10-02 踩过）。
                 HorizontalAlignment=Stretch 让按钮铺满菜单行宽，配合 HorizontalContentAlignment=Center
                 使文字在整条菜单内水平居中（消除 MinWidth=80 右侧留空造成的左贴边）。 -->
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}"/>
            <Setter Property="FontSize" Value="{ThemeResource ControlContentThemeFontSize}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Foreground" Value="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <ContentPresenter x:Name="ContentPresenter"

                                          Background="{TemplateBinding Background}"

                                          Foreground="{TemplateBinding Foreground}"

                                          BackgroundSizing="{TemplateBinding BackgroundSizing}"

                                          BorderBrush="{TemplateBinding BorderBrush}"

                                          BorderThickness="{TemplateBinding BorderThickness}"

                                          Content="{TemplateBinding Content}"

                                          ContentTemplate="{TemplateBinding ContentTemplate}"

                                          ContentTransitions="{TemplateBinding ContentTransitions}"

                                          CornerRadius="{TemplateBinding CornerRadius}"

                                          Padding="{TemplateBinding Padding}"

                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"

                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"

                                          AutomationProperties.AccessibilityView="Raw"/>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>
        </Style>

        <Style x:Key="ZoomFlyoutPresenterStyle" TargetType="FlyoutPresenter">

            <Setter Property="Padding" Value="4,4"/>

            <Setter Property="BorderThickness" Value="1"/>

            <Setter Property="CornerRadius" Value="8"/>

            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>

            <Setter Property="Background" Value="{ThemeResource FlyoutPresenterBackground}"/>

            <Setter Property="MinWidth" Value="80"/>

            <Setter Property="Transitions">

                <Setter.Value>

                    <TransitionCollection/>

                </Setter.Value>

            </Setter>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="FlyoutPresenter">

                        <Border x:Name="FlyoutPresenterRoot"

                                Background="{TemplateBinding Background}"

                                BorderBrush="{TemplateBinding BorderBrush}"

                                BorderThickness="{TemplateBinding BorderThickness}"

                                CornerRadius="{TemplateBinding CornerRadius}"

                                Padding="{TemplateBinding Padding}"

                                RenderTransformOrigin="0.5,1"

                                Loaded="FlyoutPresenterRoot_Loaded">

                            <Border.RenderTransform>

                                <ScaleTransform x:Name="FlyoutScale" ScaleY="0"/>

                            </Border.RenderTransform>

                            <Border.Resources>

                                <Storyboard x:Name="OpenAnimation">

                                    <DoubleAnimation Storyboard.TargetName="FlyoutScale"

                                                     Storyboard.TargetProperty="ScaleY"

                                                     From="0" To="1" Duration="0:0:0.2">

                                        <DoubleAnimation.EasingFunction>

                                            <CubicEase EasingMode="EaseOut"/>

                                        </DoubleAnimation.EasingFunction>

                                    </DoubleAnimation>

                                </Storyboard>

                            </Border.Resources>

                            <ContentPresenter Content="{TemplateBinding Content}"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- 设置菜单专用磨砂样式：acrylic 背景与缩放菜单一致（FlyoutPresenterBackground 与浮动面板同支，深/浅色

             自适应），但 RenderTransformOrigin=0.5,0 使其从顶沿向下展开，匹配 BottomEdgeAlignedRight

             的向下弹出朝向（缩放菜单用 0.5,1 向上展开，两者动画方向各自正确、材质统一）。 -->

        <Style x:Key="SettingsFlyoutPresenterStyle" TargetType="FlyoutPresenter">

            <Setter Property="Padding" Value="4,4"/>

            <Setter Property="BorderThickness" Value="1"/>

            <Setter Property="CornerRadius" Value="8"/>

            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>

            <Setter Property="Background" Value="{ThemeResource FlyoutPresenterBackground}"/>

            <Setter Property="MinWidth" Value="80"/>

            <Setter Property="Transitions">

                <Setter.Value>

                    <TransitionCollection/>

                </Setter.Value>

            </Setter>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="FlyoutPresenter">

                        <Border x:Name="FlyoutPresenterRoot"

                                Background="{TemplateBinding Background}"

                                BorderBrush="{TemplateBinding BorderBrush}"

                                BorderThickness="{TemplateBinding BorderThickness}"

                                CornerRadius="{TemplateBinding CornerRadius}"

                                Padding="{TemplateBinding Padding}"

                                RenderTransformOrigin="0.5,0"

                                Loaded="FlyoutPresenterRoot_Loaded">

                            <Border.RenderTransform>

                                <ScaleTransform x:Name="FlyoutScale" ScaleY="0"/>

                            </Border.RenderTransform>

                            <Border.Resources>

                                <Storyboard x:Name="OpenAnimation">

                                    <DoubleAnimation Storyboard.TargetName="FlyoutScale"

                                                     Storyboard.TargetProperty="ScaleY"

                                                     From="0" To="1" Duration="0:0:0.2">

                                        <DoubleAnimation.EasingFunction>

                                            <CubicEase EasingMode="EaseOut"/>

                                        </DoubleAnimation.EasingFunction>

                                    </DoubleAnimation>

                                </Storyboard>

                            </Border.Resources>

                            <ContentPresenter Content="{TemplateBinding Content}"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>



    </Page.Resources>



    <Page.KeyboardAccelerators>

        <KeyboardAccelerator Key="Z" Modifiers="Control" Invoked="Undo_Invoked"/>

        <KeyboardAccelerator Key="Y" Modifiers="Control" Invoked="Redo_Invoked"/>

        <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="Save_Invoked"/>

        <KeyboardAccelerator Key="P" Modifiers="Control" Invoked="Print_Invoked"/>

        <KeyboardAccelerator Key="O" Modifiers="Control" Invoked="Open_Invoked"/>

        <KeyboardAccelerator Key="D" Modifiers="Control" Invoked="AddBookmark_Invoked"/>

        <!-- 缩放：Ctrl+= / Ctrl+- 与缩放胶囊 +/- 按钮等效；Ctrl+0 = 文件原始大小(100%)。主键盘与小键盘双绑定。 -->

        <KeyboardAccelerator Key="Add" Modifiers="Control" Invoked="ZoomIn_Invoked"/>

        <KeyboardAccelerator Key="Subtract" Modifiers="Control" Invoked="ZoomOut_Invoked"/>

        <KeyboardAccelerator Key="Number0" Modifiers="Control" Invoked="ZoomReset_Invoked"/>

        <KeyboardAccelerator Key="NumberPad0" Modifiers="Control" Invoked="ZoomReset_Invoked"/>

        <!-- 阅读区键盘导航（与焦点无关，走输入管理器全局分发） -->

        <KeyboardAccelerator Key="Up" Invoked="Nav_Invoked"/>

        <KeyboardAccelerator Key="Down" Invoked="Nav_Invoked"/>

        <KeyboardAccelerator Key="Left" Invoked="Nav_Invoked"/>

        <KeyboardAccelerator Key="Right" Invoked="Nav_Invoked"/>

        <KeyboardAccelerator Key="Space" Invoked="Nav_Invoked"/>

        <KeyboardAccelerator Key="PageDown" Invoked="Nav_Invoked"/>

        <KeyboardAccelerator Key="PageUp" Invoked="Nav_Invoked"/>

        <KeyboardAccelerator Key="Home" Invoked="Nav_Invoked"/>

        <KeyboardAccelerator Key="End" Invoked="Nav_Invoked"/>

        <!-- F：适应宽度（横向布局则相应适应高度），与 FitWidthButton 行为一致 -->

        <KeyboardAccelerator Key="F" Invoked="Fit_Invoked"/>

        <!-- G：切换画笔批注显示/隐藏（会话级临时隐藏，重开回到默认显示） -->

        <KeyboardAccelerator Key="G" Invoked="ToggleAnnotations_Invoked"/>

    </Page.KeyboardAccelerators>



    <Grid RowDefinitions="*">

        <!-- Toolbar host: a clip window pinned to the very top of the page (it is pulled up

             1px so it overlaps the title bar's bottom hairline, leaving no gap). The bar

             inside slides DOWN as a rigid whole (TranslateTransform, no scaling / no

             deformation); whatever is still above the host's top edge is clipped away, so

             the bar looks like it emerges from behind the window title bar. -->

        <!-- Toolbar host: at the page root, therefore INSIDE the popup/hit-test root. WinUI raises

             PointerExited on it only when the pointer leaves the whole root (e.g. for the pen

             capsule, which lives in a popup). Used purely as a "pointer is outside the toolbar"

             watermark: a freshly opened flyout masks the toolbar and makes it raise a spurious

             PointerExited even though the pointer never left the toolbar row. -->

        <Grid x:Name="TopToolbarHost" VerticalAlignment="Top" Canvas.ZIndex="50"

              Background="Transparent"

              PointerMoved="TopToolbar_PointerMoved"

              PointerExited="TopToolbarHost_PointerExited"

              SizeChanged="TopToolbarHost_SizeChanged">

        <Border x:Name="TopToolbar"

                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="12,6"

                Background="{ThemeResource FlyoutPresenterBackground}"

                Opacity="0" IsHitTestVisible="False"

                local:ElevationShadow.IsEnabled="True" local:ElevationShadow.Elevation="20"

                PointerEntered="TopToolbar_PointerEntered" PointerExited="TopToolbar_PointerExited">

            <Border.RenderTransform>

                <TranslateTransform x:Name="TopToolbarTranslate" Y="0"/>

            </Border.RenderTransform>

        <Grid>



            <!-- Left Section: pinned to the left border; its width never shifts the centered title or right controls -->

            <StackPanel x:Name="TopLeftPanel" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Left">

                    <!-- Sidebar Toggle Button -->

                    <Button x:Name="ToggleSidebarButton" Click="ToggleSidebar_Click" Padding="8,6" Style="{StaticResource ButtonNoStateMachineStyle}">

                        <SymbolIcon Symbol="AllApps"/>

                    </Button>







                    <!-- Previous Page Button -->

                    <Button x:Name="PrevPageButton" Click="PrevPage_Click" Padding="10,6" Style="{StaticResource ButtonNoStateMachineStyle}">

                        <TextBlock Text="▲" FontSize="11"/>

                    </Button>



                    <!-- Page Number input box -->

                    <TextBox x:Name="PageNumberInput" Text="1" Width="38" Height="32"

                             HorizontalContentAlignment="Center" VerticalAlignment="Center"

                             GotFocus="PageNumberInput_GotFocus"

                             GettingFocus="PageNumberInput_GettingFocus"

                             KeyDown="PageNumberInput_KeyDown" LosingFocus="PageNumberInput_LosingFocus"/>



                    <!-- Total Pages Label -->

                    <TextBlock x:Name="TotalPagesText" Text="/ 0" VerticalAlignment="Center" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" Margin="4,0,8,0" FontSize="13"/>



                    <!-- Next Page Button -->

                    <Button x:Name="NextPageButton" Click="NextPage_Click" Padding="10,6" Style="{StaticResource ButtonNoStateMachineStyle}">

                        <TextBlock Text="▼" FontSize="11"/>

                    </Button>



                    <!-- Vertical Separator Line -->

                    <AppBarSeparator Margin="4,0"/>



                                        <!-- Annotation Mode Toggles -->

                    <ToggleButton x:Name="ReadModeButton" IsChecked="True" Click="ReadMode_Click" Padding="10,6" Style="{StaticResource ToggleButtonNoStateMachineStyle}">

                        <SymbolIcon Symbol="Read"/>

                    </ToggleButton>

                    <ToggleButton x:Name="PenModeButton" Click="PenMode_Click" Padding="10,6" Style="{StaticResource ToggleButtonNoStateMachineStyle}">

                        <SymbolIcon Symbol="Edit"/>

                    </ToggleButton>



                </StackPanel>



                <!-- Right Section: Rotate and Settings Menu -->

                <StackPanel x:Name="TopRightPanel" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Right">

                    <!-- Rotate Button -->

                    <Button x:Name="RotateButton" Click="Rotate_Click" Padding="8,6" Style="{StaticResource ButtonNoStateMachineStyle}">

                        <SymbolIcon Symbol="Rotate"/>

                    </Button>



                    <!-- Layout Toggle Button (vertical <-> horizontal continuous) -->

                    <Button x:Name="LayoutToggleButton" Click="LayoutToggle_Click" Padding="8,6" Style="{StaticResource ButtonNoStateMachineStyle}">

                        <FontIcon x:Name="LayoutToggleIcon" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE8AB;"/>

                    </Button>



                    <!-- Split View Button（打开/关闭右侧对比视图的开关；默认 Collapsed，加载 PDF 后 MainPage.xaml.cs:1746 设为可见） -->

                    <ToggleButton x:Name="SplitViewToggleButton" Click="SplitViewToggle_Click" Padding="8,6" Visibility="Collapsed" Style="{StaticResource ToggleButtonNoStateMachineStyle}">

                        <SymbolIcon Symbol="TwoPage"/>

                    </ToggleButton>



                    <!-- Save PDF Button -->

                    <Button x:Name="SaveButton" Click="SavePdf_Click" Padding="8,6" Visibility="Collapsed" Style="{StaticResource ButtonNoStateMachineStyle}">

                        <SymbolIcon Symbol="Save"/>

                    </Button>



                    <!-- Print Button -->

                    <Button x:Name="PrintButton" Click="Print_Click" Padding="8,6" Visibility="Collapsed" Style="{StaticResource ButtonNoStateMachineStyle}">

                        <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE749;"/>

                    </Button>



                    <!-- Settings Button -->

                    <Button x:Name="SettingsButton" Padding="8,6" Style="{StaticResource ButtonNoStateMachineStyle}">

                        <SymbolIcon Symbol="Setting"/>

                        <Button.Flyout>

                            <Flyout x:Name="SettingsFlyout" Placement="BottomEdgeAlignedRight" FlyoutPresenterStyle="{StaticResource SettingsFlyoutPresenterStyle}">

                                <!-- 底部预留大留白：以「卡片顶 → 第一个下拉框顶」为顶部参考（实测 ≈70 DIP，含标题行盒与上方 padding），
                                     底部同步留出 ≈69 DIP（4 presenter + 1 border + 64 panel），使上下留空对应。
                                     这块空间按用户要求预留；后续往里放内容时，把 64 收掉即可。 -->
                                <StackPanel x:Name="SettingsFlyoutPanel" Spacing="16" Width="260" Padding="4,4,4,64" KeyDown="SettingsFlyout_KeyDown">

                                    <!-- 标题行：标题(左) + 「操作指南」按钮(右, 同行右上角)。
                                         按钮移到此处后，下方布局分组与底部预留大留白(Panel Padding 底部 64)保持不变。 -->
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock x:Name="SettingsTitleText" Grid.Column="0" Text="Configuración" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>

                                        <!-- 操作指南按钮：与标题同行、置于右上角。
                                             内容 = ReadingMode 图标(U+E736, Segoe MDL2 Assets) + 文字，图标放文字前（语义 ReadingMode）。
                                             hover/pressed 反馈由 MainPage.xaml.cs 的 ButtonVisualOverride.Attach(GuideButton, inPopupTree:true) 提供。 -->
                                        <Button x:Name="GuideButton" Grid.Column="1" Style="{StaticResource ButtonNoStateMachineStyle}" Click="GuideButton_Click"
                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Padding="8,4"
                                                UseLayoutRounding="True" IsTabStop="False">

                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <!-- 字体回退列表：Win11 优先用推荐的 Segoe Fluent Icons，Win10 回退到 Segoe MDL2 Assets。
                                                     两个字体在 U+E736 处均映射为 ReadingMode（已查 Microsoft Learn 官方表确认），
                                                     故回退不会改变语义图标，只切换视觉风格，天然自适应 Win10/Win11。 -->
                                                <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE736;" FontSize="13" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="GuideButtonText" Text="Operations Guide" FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>

                                        </Button>
                                    </Grid>



                                    <!-- Theme Selector -->

                                    <StackPanel Spacing="6">

                                        <TextBlock x:Name="AppThemeLabel" Text="Tema de la aplicación" FontSize="12" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>

                                        <ComboBox x:Name="ThemeComboBox" SelectionChanged="ThemeComboBox_SelectionChanged" HorizontalAlignment="Stretch" IsTabStop="False">

                                            <ComboBoxItem x:Name="ThemeLightItem" Content="Claro" Tag="Light"/>

                                            <ComboBoxItem x:Name="ThemeDarkItem" Content="Oscuro" Tag="Dark"/>

                                            <ComboBoxItem x:Name="ThemeDefaultItem" Content="Predeterminado del sistema" Tag="Default"/>

                                        </ComboBox>

                                    </StackPanel>



                                    <!-- Layout View Selector -->

                                    <StackPanel Spacing="6">

                                        <TextBlock x:Name="LayoutViewLabel" Text="Layout View" FontSize="12" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>

                                        <ComboBox x:Name="LayoutViewComboBox" SelectionChanged="LayoutViewComboBox_SelectionChanged" HorizontalAlignment="Stretch" IsTabStop="False">

                                            <ComboBoxItem x:Name="SinglePageItem" Content="Single Page" Tag="0"/>

                                            <ComboBoxItem x:Name="TwoPageItem" Content="Two Pages" Tag="1"/>

                                            <ComboBoxItem x:Name="BookItem" Content="Book" Tag="2"/>

                                        </ComboBox>

                                    </StackPanel>

                                </StackPanel>

                            </Flyout>

                        </Button.Flyout>

                    </Button>

                </StackPanel>

            </Grid>

        </Border>

        </Grid>



        <!-- Pen options: single-row floating capsule.

             Layout: 7 color dots | vertical hairline | 5 thickness circles.

             Background="{x:Null}" on buttons removes WinUI's default template

             background border so circular highlights render perfectly round.

             Height="42" (pixel-locked) matches the bottom-right zoom pill and

             bottom-left save toast, so all three capsules render identical height.

             Content is 28px (thickness buttons) + 6*2 padding + 1*2 border = 42,

             so the centered StackPanel fills it exactly — no button offset. -->

        <Popup x:Name="PenOptionsPopup"

               ShouldConstrainToRootBounds="True">

            <Border x:Name="PenOptionsCapsule"

                    Background="{ThemeResource FlyoutPresenterBackground}"

                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"

                    BorderThickness="1"

                    CornerRadius="20"

                    Height="42"

                    Padding="10,6"

                    local:ElevationShadow.IsEnabled="True" local:ElevationShadow.Elevation="18"

                    PointerEntered="PenOptionsCapsule_PointerEntered"

                    PointerExited="PenOptionsCapsule_PointerExited">

                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">

                    <!-- ══════════ 颜色选择器：7 个圆形按钮（按钮本体即圆点）══════════



                         圆点 = 按钮自身的 Background + CornerRadius（16×16 配 CornerRadius=8 时，

                         四段 1/4 圆弧共用圆心，正好是正圆）。由框架按【最终尺寸】直接绘制，边缘是

                         矢量级抗锯齿 —— 不再用 RenderTransform 放大（那只是把已光栅化的 16px 圆点

                         拉伸，边缘发糊，即用户反馈的模糊根因）。



                         放大（悬浮/选中）同样不用 RenderTransform，而是改【布局尺寸】：

                           Width/Height 16 → 25.6、CornerRadius 8 → 12.8、Margin 0 → -4.8（四边）。

                         负 Margin 恰好抵消增大的尺寸 ⇒ 布局槽位仍为 16×16，相邻圆点间距与圆心位置

                           逐像素不变，放大的圆点相对自身中心向四周均匀溢出（StackPanel 不裁剪子元素，

                           与原 RenderTransform 的表现一致）。



                         TranslateTransform Y=-1 沿用原光学补偿：2px 透明描边的圆点因 DWM 抗锯齿

                           看起来比几何中心低 1px。



                         ⚠ 悬浮/按下的底色必须是圆点自身色：WinUI 模板的 PointerOver/Pressed 状态会把

                           ContentPresenter.Background 换成主题底色、把 BorderBrush 换成主题描边，

                           从而盖掉圆点/勾出边框。这四个键必须【逐按钮】声明（每颗圆点底色不同，无法

                           共用一份字典），且只在解析期写一次 —— 运行时写 element.Resources 会在主题

                           切换回调里抛 COMException，进程直接闪退（2026-09-29 崩溃）。 -->

                    <StackPanel x:Name="ColorSelectorPanel" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">

                        <StackPanel.RenderTransform>

                            <TranslateTransform Y="-1"/>

                        </StackPanel.RenderTransform>

                        <!-- 画笔色板：高饱和、清晰可分的一组记号笔色（详见 2026-09-22 日志）。

                             不再强行统一明度——按色相自然分布明度以拉开绿/青/蓝、红/品红之间的区分；

                             饱和度保持 66–90% 的一致性家族。黄为金黄（白纸上对比有限是其物理属性），黑作中性锚点不动。 -->

                        <Button x:Name="ColorYellowButton" Click="Color_Click" Tag="#F2C200" Width="16" Height="16" MinWidth="16" MinHeight="16" VerticalAlignment="Center" CornerRadius="8" Background="#F2C200" BorderThickness="2" BorderBrush="Transparent" Padding="0">

                            <Button.Resources>

                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#F2C200"/>

                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#F2C200"/>

                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>

                                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent"/>

                            </Button.Resources>

                        </Button>

                        <Button x:Name="ColorGreenButton" Click="Color_Click" Tag="#2FA84F" Width="16" Height="16" MinWidth="16" MinHeight="16" VerticalAlignment="Center" CornerRadius="8" Background="#2FA84F" BorderThickness="2" BorderBrush="Transparent" Padding="0">

                            <Button.Resources>

                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#2FA84F"/>

                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#2FA84F"/>

                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>

                                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent"/>

                            </Button.Resources>

                        </Button>

                        <Button x:Name="ColorCyanButton" Click="Color_Click" Tag="#16B1C4" Width="16" Height="16" MinWidth="16" MinHeight="16" VerticalAlignment="Center" CornerRadius="8" Background="#16B1C4" BorderThickness="2" BorderBrush="Transparent" Padding="0">

                            <Button.Resources>

                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#16B1C4"/>

                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#16B1C4"/>

                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>

                                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent"/>

                            </Button.Resources>

                        </Button>

                        <Button x:Name="ColorMagentaButton" Click="Color_Click" Tag="#E84FA6" Width="16" Height="16" MinWidth="16" MinHeight="16" VerticalAlignment="Center" CornerRadius="8" Background="#E84FA6" BorderThickness="2" BorderBrush="Transparent" Padding="0">

                            <Button.Resources>

                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#E84FA6"/>

                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#E84FA6"/>

                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>

                                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent"/>

                            </Button.Resources>

                        </Button>

                        <Button x:Name="ColorRedButton" Click="Color_Click" Tag="#E5393B" Width="16" Height="16" MinWidth="16" MinHeight="16" VerticalAlignment="Center" CornerRadius="8" Background="#E5393B" BorderThickness="2" BorderBrush="Transparent" Padding="0">

                            <Button.Resources>

                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#E5393B"/>

                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#E5393B"/>

                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>

                                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent"/>

                            </Button.Resources>

                        </Button>

                        <Button x:Name="ColorBlueButton" Click="Color_Click" Tag="#2E6FE0" Width="16" Height="16" MinWidth="16" MinHeight="16" VerticalAlignment="Center" CornerRadius="8" Background="#2E6FE0" BorderThickness="2" BorderBrush="Transparent" Padding="0">

                            <Button.Resources>

                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#2E6FE0"/>

                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#2E6FE0"/>

                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>

                                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent"/>

                            </Button.Resources>

                        </Button>

                        <Button x:Name="ColorBlackButton" Click="Color_Click" Tag="#000000" Width="16" Height="16" MinWidth="16" MinHeight="16" VerticalAlignment="Center" CornerRadius="8" Background="Black" BorderThickness="2" BorderBrush="Transparent" Padding="0">

                            <Button.Resources>

                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Black"/>

                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Black"/>

                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>

                                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent"/>

                            </Button.Resources>

                        </Button>

                    </StackPanel>



                    <!-- Vertical separator hairline -->

                    <Rectangle Width="1" Height="24"

                               Fill="{ThemeResource SystemControlForegroundBaseLowBrush}"

                               Opacity="0.6"/>



                    <!-- Thickness preset circles (28x28).

                         ThicknessHighlight uses negative margin (-1) to overflow the button

                         bounds by 1px on each side, covering any rectangular template

                         background corners that WinUI may render. -->

                    <StackPanel x:Name="ThicknessPresetPanel" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">

                        <Button x:Name="Thickness1Button" Click="ThicknessPreset_Click" Tag="1" Width="28" Height="28" MinWidth="28" MinHeight="28" VerticalAlignment="Center" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" CornerRadius="14">

                            <Grid>

                                <Border x:Name="Thickness1Highlight" Margin="-1,-1,-1,-1" CornerRadius="15" Background="Transparent"/>

                                <Border Width="18" Height="2"  CornerRadius="1"   HorizontalAlignment="Center" VerticalAlignment="Center" Background="{ThemeResource SystemControlForegroundBaseHighBrush}"/>

                            </Grid>

                        </Button>

                        <Button x:Name="Thickness2Button" Click="ThicknessPreset_Click" Tag="2" Width="28" Height="28" MinWidth="28" MinHeight="28" VerticalAlignment="Center" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" CornerRadius="14">

                            <Grid>

                                <Border x:Name="Thickness2Highlight" Margin="-1,-1,-1,-1" CornerRadius="15" Background="Transparent"/>

                                <Border Width="18" Height="3"  CornerRadius="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{ThemeResource SystemControlForegroundBaseHighBrush}"/>

                            </Grid>

                        </Button>

                        <Button x:Name="Thickness3Button" Click="ThicknessPreset_Click" Tag="3.5" Width="28" Height="28" MinWidth="28" MinHeight="28" VerticalAlignment="Center" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" CornerRadius="14">

                            <Grid>

                                <Border x:Name="Thickness3Highlight" Margin="-1,-1,-1,-1" CornerRadius="15" Background="Transparent"/>

                                <Border Width="18" Height="4"  CornerRadius="2"   HorizontalAlignment="Center" VerticalAlignment="Center" Background="{ThemeResource SystemControlForegroundBaseHighBrush}"/>

                            </Grid>

                        </Button>

                        <Button x:Name="Thickness7Button" Click="ThicknessPreset_Click" Tag="7" Width="28" Height="28" MinWidth="28" MinHeight="28" VerticalAlignment="Center" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" CornerRadius="14">

                            <Grid>

                                <Border x:Name="Thickness7Highlight" Margin="-1,-1,-1,-1" CornerRadius="15" Background="Transparent"/>

                                <Border Width="18" Height="7"  CornerRadius="3.5" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{ThemeResource SystemControlForegroundBaseHighBrush}"/>

                            </Grid>

                        </Button>

                        <Button x:Name="Thickness14Button" Click="ThicknessPreset_Click" Tag="14" Width="28" Height="28" MinWidth="28" MinHeight="28" VerticalAlignment="Center" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" CornerRadius="14">

                            <Grid>

                                <Border x:Name="Thickness14Highlight" Margin="-1,-1,-1,-1" CornerRadius="15" Background="Transparent"/>

                                <Border Width="18" Height="14" CornerRadius="7"   HorizontalAlignment="Center" VerticalAlignment="Center" Background="{ThemeResource SystemControlForegroundBaseHighBrush}"/>

                            </Grid>

                        </Button>

                    </StackPanel>

                </StackPanel>

            </Border>

        </Popup>



        <!-- Welcome Screen (Visible when no PDF is loaded) -->

        <Grid Grid.Row="0" x:Name="WelcomePanel" Background="Transparent" Padding="40" RowDefinitions="Auto, *">

            <!-- Header section with open button -->

            <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,24">

                <TextBlock Text="Glance" FontSize="28" FontWeight="Bold"/>

                <TextBlock x:Name="WelcomeSubtitleText" Text="Abre un documento para comenzar." FontSize="14" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>



                <!-- 配色走 App.xaml 的 GlanceAccentButtonStyle（Obsidian 紫，10-05 已改为无状态机模板）；
                     覆盖 generic 的 AccentButton* 主题键无效（见 App.xaml 第 12 轮注释）。视觉 hover/pressed
                     由 MainPage.xaml.cs 的 ButtonVisualOverride.Attach(OpenPdfButton, accent: true) 几何驱动，
                     消除点击弹文件选择器时的 VSM flicker。

                     ⚠ 文字相对图标"下坠 ~1px"的根因（10-04 像素取证 @125% DPI，仅作记录，已回调）：
                     CJK 行盒的 ascent 余量 > descent ⇒ 文字【墨迹视觉重心】落在其行盒中心下方 δ≈0.8 DIP，
                     而 SymbolIcon 字形居中 ⇒ 目测文字比图标低（实测 text_center−icon_center = +1.0px）。
                     ⚠ 此处【不能】靠 VerticalContentAlignment 修：按钮高度由内容撑开 + generic 未设该属性
                     ⇒ 不产生布局效果。10-04 曾用 RenderTransform Y=-1 做光学补偿，但 F5 后主观不顺眼、
                     用户判定原状（无补偿）的"微妙平衡"更优 ⇒ 已撤销补偿，恢复原始无 VerticalAlignment / 无
                     RenderTransform 的状态。此根因注释保留以便后续若重做字体/行盒时参考。 -->

                <Button x:Name="OpenPdfButton" Click="OpenPdf_Click" Margin="0,16,0,0" Style="{ThemeResource GlanceAccentButtonStyle}" Padding="16,8">

                    <StackPanel Orientation="Horizontal" Spacing="8">

                        <SymbolIcon Symbol="OpenFile"/>

                        <TextBlock x:Name="WelcomeOpenButtonText" Text="Abrir Documento PDF" FontWeight="SemiBold"/>

                    </StackPanel>

                </Button>

            </StackPanel>



            <!-- Recent Documents Grid removed: welcome page no longer shows recent files -->

        </Grid>



        <!-- Main content area containing SplitView for the Collapsible Sidebar (Visible when PDF is loaded) -->

        <!-- DisplayMode=Inline：侧边栏【挤开】主视图——主视图向右位移并变窄（而非盖住）。

             主视图全程可正常导航/缩放（无 light-dismiss 覆盖层遮挡）；展开/收起后由 C# 侧

             RefitViewerAfterSidebar() 按新视口重新 Fit 一次，保证 PDF 铺满可见区域。 -->

        <SplitView Grid.Row="0" x:Name="SidebarSplitView" DisplayMode="Inline" IsPaneOpen="False" OpenPaneLength="220" Background="Transparent" Visibility="Collapsed">

            <!-- SplitView Pane: Sidebar with page index -->

            <SplitView.Pane>

            <!-- 主题实色背景（Inline 下 Pane 与主视图并排不重叠，背景取主题画刷即可，干净利落） -->

            <!-- ⚠ 顶部 Padding 由 C# 侧 UpdateSidebarTopInset() 按实测工具栏高度写入（不在此硬编码）：

                 工具栏是同一根 Grid 里 ZIndex=50 的浮层，恒盖在 SidebarSplitView（ZIndex=0）之上，

                 若侧边栏内容从 y=0 起排，展开工具栏会切掉标题行与第一张缩略图的上沿。 -->

            <!-- 侧边栏右沿：**无任何结构** —— 无投影载体、无 1px 界线，面板到此为止。
                 分界完全交给内容本身（打开的 PDF 页面白纸边缘 / 欢迎页自身背景）。
                 ⚠ 不要再给本面板加 BorderBrush：
                    ① 若引用 App.xaml 主题字典里的【自定义】键（如曾经的 GlanceSidebarDivider），
                       实测会破坏 WindowsAppSDK 2.2.1 的主题切换 —— 各元素解析出不同主题导致配色错乱，
                       并最终让按钮取错主题字典崩在 GlanceFillNeutralPressed（2026-10-06 复现定位）。
                    ② 若覆盖系统键 CardStrokeColorDefaultBrush，会连坐本文件另外 9 处引用
                       （含缩略图卡片边框）且系统内部 25 个 StaticResource 别名不会跟着变。
                 若将来确实需要分界，用【代码后置】单独给本面板赋画刷（参照 MainWindow.UpdateWindowBackground）。

                 【接缝处 1px 竖线的成因 —— 已定位，当前未处理】SplitView 模板里 PaneRoot 靠布局定位、
                 ContentRoot 靠 CompositeTransform 位移（generic.xaml:35818 / :35842），两条边各自取整
                 ⇒ 接缝漏出约 1px 的 SplitView 底色；而它 Background=Transparent ⇒ 透出 WindowRoot 的
                 #FAFAFA(浅) / #1C1C1C(深)，形成一条 1px 竖线（实测确认）。
                 处理：Margin="0,0,-1,0" —— 面板向右探出 1px 压住缝（**用户实测验证可行后采用**）。
                 本质是用溢出覆盖：那 1px 处画的是【侧栏自己的底】，不再是透出来的窗口底。
                 （曾因"跨缩放比 / 动画中途的副作用无法逐一验证"一度回退到 Margin=0，用户自行实测后重新启用。）
                 ⚠ 另记：改 OpenPaneLength 无效 —— Pane 宽度与 Content 位移由同一值驱动、一起动，
                    是"移动缝"不是"消缝"，缝只会跟着整体挪位置。 -->
            <!-- 侧边栏底色由【代码后置】UpdateSidebarBackground() 按主题着色（与主视图基色区分，现代分层配色），
                 此处 Background 仅作构造期首帧前的系统键兜底（ApplicationPageBackgroundThemeBrush 是系统键、安全），
                 不要在此改颜色、也不要引用 App.xaml 自定义主题键（破坏主题切换，见 2026-10-06 根因）。 -->
            <Grid x:Name="ThumbnailSidebarPanel" Padding="0,14,0,0" Margin="0,0,-1,0" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>



                    <!-- Sidebar mode switcher: thumbnails / bookmarks / outline

                         ⚠ 全项目 FontIcon 一律用此字体族：'Segoe Fluent Icons' 仅 Win11 自带，

                         写死单字体会在 Win10 落豆腐块。改用 DirectWrite 回退链

                         "Segoe Fluent Icons,Segoe MDL2 Assets"（= WinUI 内建 SymbolThemeFontFamily

                         的值）：Win11 全取 Fluent、Win10 全取 MDL2 —— 两平台各自观感统一。 -->

                    <Grid Grid.Row="0" Margin="8,8,0,0">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="Auto"/>

                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">

                            <!-- 三颗模式键共用同一套状态机接管样式（ToggleButtonNoStateMachineStyle）：

                                 互斥切换由 ApplySidebarMode() 程序化改 IsChecked，接管器会把每一次

                                 (checked, pressed, 坐标几何 hover) 变化瞬间写成颜色，不再被原生

                                 Storyboard 拖成 83ms 渐变。各自的 Padding / HorizontalContentAlignment

                                 是元素本地值，优先级高于样式 setter，模板有 TemplateBinding 接得住。 -->

                            <ToggleButton x:Name="ModeThumbnailsButton" Click="SidebarMode_Click" Tag="Thumbnails" IsChecked="True" Padding="8,6" HorizontalContentAlignment="Center" Style="{StaticResource ToggleButtonNoStateMachineStyle}">

                                <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE7C3;"/>

                            </ToggleButton>

                            <ToggleButton x:Name="ModeBookmarksButton" Click="SidebarMode_Click" Tag="Bookmarks" Padding="8,6" HorizontalContentAlignment="Center" Style="{StaticResource ToggleButtonNoStateMachineStyle}">

                                <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE728;"/>

                            </ToggleButton>

                            <ToggleButton x:Name="ModeOutlineButton" Click="SidebarMode_Click" Tag="Outline" Padding="8,6" HorizontalContentAlignment="Center" Style="{StaticResource ToggleButtonNoStateMachineStyle}">

                                <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE71D;"/>

                            </ToggleButton>

                        </StackPanel>



                        <!-- 添加书签：单独放在模式按钮右侧的长按钮，外观沿用 Button 默认模板

                             （与 ToggleButton 同一套 ControlFill/ControlStroke/圆角，故与三模式按钮观感一致），

                             内部不写字，只有一枚金色实心五角星（#F2C200 = 画笔色板黄）。

                             Padding="8,6" 与模式按钮完全相同 → 高度恒等。

                             【右沿对齐缩略图可点区域】全部按 XAML 尺寸推导，不依赖截图：

                               · Pane 内容盒 = OpenPaneLength 220 − 面板右 BorderThickness 1 = 219

                               · 缩略图 ListView 无左右 Margin → 其容器 ListViewItem 就是"浅灰可点区域"，

                                 右沿 = 219 − 框架默认项内缩 8 = 211

                               · 本按钮在同一 219 宽的列内 → 右 Margin 取 8，右沿同样落在 211

                               · 左 Margin 8（略大于模式按钮间距 4）→ 按 219−138−8 得按钮宽 73

                             【星形居中奇偶】星形实心横向 21 设备像素（奇数）→ 按钮设备宽也须奇数：

                             125% 缩放下 73×1.25 = 91.25 → 91 设备像素（奇数）✓，

                             星形左右各留 35 设备像素，完全对称（此前 69 逻辑宽 = 87 像素时是 33/33）。

                             若换缩放比后两侧不等，只改左 Margin ±0.8（=1 设备像素）即可纠偏，

                             右沿对齐不受影响。

                             ⚠ HorizontalAlignment="Stretch" 必须显式写：Button 默认样式自带

                             HorizontalAlignment=Left + VerticalAlignment=Center（贴内容不撑满），

                             不写只会缩在所在列左端、右侧留空。

                             ⚠ MinWidth="0" 必须保留：Button 默认 MinWidth=120 会撑破 219 宽的侧边栏。 -->

                        <Button Grid.Column="1" x:Name="AddBookmarkButton" Click="AddBookmark_Click" Style="{StaticResource ButtonNoStateMachineStyle}"

                                Margin="8,0,8,0" Padding="8,6" MinWidth="0"

                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"

                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center">

                            <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE735;" Foreground="#F2C200"/>

                        </Button>

                    </Grid>



                    <!-- Section header -->

                    <Grid Grid.Row="1" Margin="16,12,16,6">

                        <TextBlock x:Name="SidebarHeaderText" Text="Miniaturas" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" VerticalAlignment="Center"/>

                    </Grid>



                    <!-- Thumbnails -->

                    <ListView Grid.Row="2" x:Name="PageListView" IsItemClickEnabled="True" ItemClick="PageListView_ItemClick" Background="Transparent" Margin="0,0,0,8" ContainerContentChanging="PageListView_ContainerContentChanging" IsTabStop="False">

                        <!-- ⚠ 严禁设 CacheLength=0/过小：ItemsStackPanel 只 realized 可见项后，

                             ScrollIntoView/选中项自动滚动对 unrealized 目标项失效 → 侧边栏无法跟随主视图

                             当前页（第41轮实测回归）。保留默认 4.0（视口外前后各 2 屏 realized），

                             缩略图渲染量改由 C# 侧"待渲染任务上限 + 按侧边栏视口中心补位"控制（见

                             RenderThumbnailAsync/RefillThumbnailQueue），不再依赖 CacheLength。 -->

                        <ListView.ItemTemplate>

                            <DataTemplate x:DataType="local:PdfPageViewModel">

                                <!-- x:Bind with OneWay is completely virtualization-safe when using observable properties -->

                                <!-- 外层 Grid 只用来承载"行内书签星"覆盖层：星声明在内容 Grid 之后 →

                                     天然位于最顶层（后声明者在上），且它自己吃掉指针事件 →

                                     点它只切书签，不会触发 ListView 的 ItemClick 跳页。

                                     横坐标在此写死（HorizontalAlignment=Right，见下方星注释的几何推导），

                                     此处只管尺寸与纵向居中。 -->

                                <Grid HorizontalAlignment="Stretch">

                                    <Grid ColumnDefinitions="Auto, *" Padding="4,4" RowSpacing="4" ColumnSpacing="12" HorizontalAlignment="Stretch">

                                        <!-- Page preview image container -->

                                        <Border Grid.Column="0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Width="36" Height="48" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" CornerRadius="2" VerticalAlignment="Center">

                                            <Image Source="{x:Bind ThumbnailSource, Mode=OneWay}" Stretch="Uniform"/>

                                        </Border>

                                        <TextBlock Grid.Column="1" Text="{x:Bind PageNumberText, Mode=OneWay}" FontSize="12" VerticalAlignment="Center" FontWeight="Medium"/>

                                    </Grid>

                                    <!-- 行内书签星：空心(E734，灰边) ↔ 实心(E735，同顶部黄星 #F2C200)。

                                         水平位置写死：HorizontalAlignment=Right 直接贴 ListViewItem

                                         内容区右缘 —— 内容区右缘 ≈ 219 − 框架默认项内缩 8 = 211，

                                         与顶部黄星按钮右缘（面板 219 − 右 Margin 8 = 211）同一坐标，

                                         见上方 AddBookmarkButton 注释的几何推导。

                                         ⚠ 历史教训（2026-09-28）：曾用 C# 运行时测量对齐星心

                                         （TransformToVisual 反推 + DispatcherQueue 自排队重试），

                                         侧栏未布局时重试无限自排队 ⇒ 打开侧边栏直接卡死，已整体回退。

                                         此后不再对这颗星做任何运行时几何计算。

                                         ⚠ 这里刻意不用 Button：ButtonBase 按下时会 CapturePointer，

                                         指针一被捕获，所在缩略图行立刻收到 PointerExited → 整行悬浮提示色

                                         消失（松手后才恢复，表现为提示色闪烁）。改用不捕获指针的 Grid，

                                         自行处理指针：PointerPressed 标 Handled 阻止 ListViewItem 进入按下态

                                         并捕获指针（那会同样打断悬浮态）；Tapped 标 Handled 阻止它据此

                                         抛出 ItemClick（不跳页）。

                                         Background="Transparent" 必须有，否则空白处不参与命中测试。 -->

                                    <Grid x:Name="RowStarButton"

                                          PointerPressed="RowStar_PointerPressed"

                                          Tapped="RowStar_Tapped"

                                          Width="32" Height="32" Background="Transparent"

                                          HorizontalAlignment="Right" VerticalAlignment="Center">

                                        <Grid>

                                            <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE734;"

                                                      Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"

                                                      Visibility="{x:Bind IsNotBookmarked, Mode=OneWay}"/>

                                            <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE735;"

                                                      Foreground="#F2C200"

                                                      Visibility="{x:Bind IsBookmarked, Mode=OneWay}"/>

                                        </Grid>

                                    </Grid>

                                </Grid>

                            </DataTemplate>

                        </ListView.ItemTemplate>

                    </ListView>



                    <!-- Bookmarks -->

                    <!-- ⚠ 点击必须走【容器级】IsItemClickEnabled/ItemClick，与缩略图(PageListView)、

                         大纲(OutlineListView) 完全同源；这里早先改成"行内 Grid 挂 Tapped"是错的：

                         ① 行 Grid 没有 Background（本文件那个行内星注释里记录过的规则：

                            无背景则空白处【不参与命中测试】）→ 点在行的空白区（左右 4px / 上下 6px

                            padding、以及文字与按钮之间的空档）根本命中不到这一层；

                         ② 命中空白区的指针会穿透到 ListViewItem，而本列表是三个列表里

                            唯一没有 IsItemClickEnabled 的 → 容器也没有兜底 ⇒ 点了毫无反应 = "卡在原地"。

                         容器级点击的关键点：ListViewItem 容器自身就是命中目标，与子元素的背景无关

                         （缩略图/大纲行模板同样是无背景 Grid，但它们能点，正是因为走的是这一条路）。 -->

                    <ListView Grid.Row="2" x:Name="BookmarkListView" Visibility="Collapsed" Background="Transparent" Margin="0,0,0,8" IsTabStop="False"

                              SelectionMode="None" IsItemClickEnabled="True" ItemClick="BookmarkListView_ItemClick">

                        <ListView.ItemTemplate>

                            <DataTemplate x:DataType="local:BookmarkViewModel">

                                <!-- ⚠ 这里【不再】挂 Tapped：跳转改由 ListView 容器级 ItemClick

                                     (BookmarkListView_ItemClick) 承担，见上方 ListView 的注释。

                                     若两处都留，一次点击会先冒泡到本 Grid 的 Tapped、再被容器转成

                                     ItemClick，导航做两遍（幂等但多余）。 -->

                                <Grid Padding="4,6" ColumnDefinitions="*,Auto,Auto,Auto" HorizontalAlignment="Stretch">

                                    <TextBlock Grid.Column="0" Text="{x:Bind DisplayName, Mode=OneWay}" VerticalAlignment="Center" Visibility="{x:Bind IsReadOnly, Mode=OneWay}" FontSize="12"/>

                                    <!-- ⚠ 文字"贴左上角"的根因在模板，不在本行的排版参数：

                                         WinUI3 的 DefaultTextBoxStyle 内容宿主 ScrollViewer(x:Name="ContentElement")

                                         只绑 Padding/Margin，**不绑 VerticalContentAlignment**（WindowsAppSDK 2.2.1

                                         的 Microsoft.UI.Xaml/Themes/generic.xaml:23984-23985：BorderElement 只绑

                                         MinHeight，ScrollViewer 那一行里没有该绑定）⇒ 该属性对 TextBox 无效，

                                         内容恒贴"内容盒"左上；模板里能"看起来居中"的唯一机制是

                                         **内容盒被行高刚好填满（余量 0，无处可偏）**——工具栏 PageNumberInput 正是如此：

                                         行高≈18.67(FontSize 14) + 默认 Padding 10,5,6,6 + 边框 2 ≈ Height 32 → 余量≈0。

                                         原 Padding="4,2" 的内容盒 = 32−2−4 = 26 DIP，而 12pt 行高只有 16 DIP

                                         ⇒ 10 DIP 余量全落在文字下方（125% 缩放实测：盒高 32 DIP，文字上留白 7px / 下留白 20px，

                                         与"贴顶 + Padding.top=2"逐像素吻合）。现改用同一机制：

                                         MinHeight=0 让盒高贴合 行高16 + 内边距6+6 + 边框1+1 = 30 DIP ⇒ 余量恒为 0

                                         （随字号/文本缩放自适应）。MinHeight=0 必须写，主题默认 MinHeight=32 会重新撑出余量；

                                         Padding 保持 4,6（与只读态 TextBlock 左沿对齐，同一 Grid Padding），不要改小。 -->

                                    <TextBox Grid.Column="0" x:Name="BookmarkEditBox" Text="{x:Bind EditText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="{x:Bind IsEditing, Mode=OneWay}" FontSize="12" MinHeight="0" Padding="4,6" VerticalAlignment="Center" Background="Transparent" BorderThickness="1" KeyDown="BookmarkEditBox_KeyDown" LostFocus="BookmarkEditBox_LostFocus"/>



                                    <Button Grid.Column="1" Click="BookmarkEdit_Click" Visibility="{x:Bind IsReadOnly, Mode=OneWay}" Padding="6,2" Background="Transparent" BorderThickness="0" Margin="2,0,0,0">

                                        <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE70F;" FontSize="12"/>

                                    </Button>

                                    <Button Grid.Column="1" Click="BookmarkConfirm_Click" Visibility="{x:Bind IsEditing, Mode=OneWay}" Padding="6,2" Background="Transparent" BorderThickness="0" Margin="2,0,0,0">

                                        <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE73E;" FontSize="12"/>

                                    </Button>

                                    <Button Grid.Column="2" Click="BookmarkCancel_Click" Visibility="{x:Bind IsEditing, Mode=OneWay}" Padding="6,2" Background="Transparent" BorderThickness="0" Margin="2,0,0,0">

                                        <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE711;" FontSize="12"/>

                                    </Button>

                                    <Button Grid.Column="3" Click="BookmarkDelete_Click" Padding="6,2" Background="Transparent" BorderThickness="0" Margin="2,0,0,0">

                                        <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE74D;" FontSize="12"/>

                                    </Button>

                                </Grid>

                            </DataTemplate>

                        </ListView.ItemTemplate>

                    </ListView>



                    <!-- Outline -->

                    <ListView Grid.Row="2" x:Name="OutlineListView" Visibility="Collapsed" Background="Transparent" Margin="0,0,0,8" IsTabStop="False" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OutlineListView_ItemClick">

                        <ListView.ItemTemplate>

                            <DataTemplate x:DataType="local:OutlineItemViewModel">

                                <Grid Padding="4,6" ColumnDefinitions="Auto,*" HorizontalAlignment="Stretch">

                                    <Rectangle Grid.Column="0" Width="{x:Bind Indent}"/>

                                    <TextBlock Grid.Column="1" Text="{x:Bind Title}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                </Grid>

                            </DataTemplate>

                        </ListView.ItemTemplate>

                    </ListView>

                </Grid>

            </SplitView.Pane>



            <!-- SplitView Content: Vertically virtualized list of PDF pages, completely transparent container -->

            <Grid x:Name="ViewerContainerGrid">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition x:Name="SyncScrollColumn" Width="0"/>

                    <ColumnDefinition x:Name="SecondaryViewerColumn" Width="0"/>

                </Grid.ColumnDefinitions>






                <local:GpuPageView Grid.Column="0" x:Name="GpuViewer" Visibility="Collapsed" PointerPressed="GpuViewer_PointerPressed"/>



                <!-- Divider Line + Sync Scrollbar (middle column) -->

                <Border Grid.Column="1" x:Name="ViewerDivider" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,1,0" Visibility="Collapsed"/>

                <ScrollBar Grid.Column="1" x:Name="SyncScrollBar" Orientation="Vertical" Visibility="Collapsed"

                           Scroll="SyncScrollBar_Scroll" HorizontalAlignment="Center" Width="14"

                           IndicatorMode="MouseIndicator">

                    <ScrollBar.Resources>

                        <SolidColorBrush x:Key="ScrollBarThumbBackground" Color="Red"/>

                        <SolidColorBrush x:Key="ScrollBarPanningThumbBackground" Color="Red"/>

                        <SolidColorBrush x:Key="ScrollBarThumbFillDisabled" Color="Red"/>

                    </ScrollBar.Resources>

                </ScrollBar>



                <!-- Right/Secondary Viewer -->

                <Grid Grid.Column="2" x:Name="SecondaryViewerContainer" Visibility="Collapsed">

                    <!-- GPU 阅读器（右/对比视图，Win2D 呈现层，默认隐藏）。与左 GpuViewer 同款，旧 ScrollViewer+Image 路径已整体移除。 -->

                    <local:GpuPageView x:Name="GpuViewerRight" Visibility="Collapsed"/>



                    <!-- PDF content fills entire area (same viewport size as left side) -->



                    <!-- Floating round controls for the comparison pane. The old drop-down bar

                         was removed: it never sat well next to the main toolbar. These follow

                         the bottom zoom pill's language instead — invisible until hovered

                         (Opacity=0 still hit-tests), 0.15s fade both ways. That 0.15s is the

                         app-wide transition duration (see UiTransitionMs in MainPage.xaml.cs);

                         the top toolbar slide uses the same number.

                         The outer Grid is padded so the hover target is comfortably larger

                         than the 36px circle it reveals.

                         Top margin is a fallback only: UpdateSecondaryPillTopOffset() rewrites

                         it from the measured toolbar height so the expanded top toolbar never

                         covers these buttons. -->

                    <Grid x:Name="SecondaryOpenPill"

                          HorizontalAlignment="Left" VerticalAlignment="Top"

                          Margin="4,47,0,0" Padding="8"

                          Background="Transparent" Canvas.ZIndex="40"

                          PointerEntered="SecondaryOpenPill_PointerEntered"

                          PointerExited="SecondaryOpenPill_PointerExited">

                        <Grid.Resources>

                            <Storyboard x:Name="SecondaryOpenPillShowAnim">

                                <DoubleAnimation Storyboard.TargetName="SecondaryOpenPillBorder" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>

                            </Storyboard>

                            <Storyboard x:Name="SecondaryOpenPillHideAnim">

                                <DoubleAnimation Storyboard.TargetName="SecondaryOpenPillBorder" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>

                            </Storyboard>

                        </Grid.Resources>

                        <Border x:Name="SecondaryOpenPillBorder"

                                Background="{ThemeResource FlyoutPresenterBackground}"

                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"

                                BorderThickness="1"

                                CornerRadius="20"

                                Opacity="1"

                                local:ElevationShadow.IsEnabled="True" local:ElevationShadow.Elevation="18">

                            <Button x:Name="OpenSecondPdfButton" Click="OpenSecondPdf_Click" Style="{StaticResource ButtonNoStateMachineStyle}"

                                    Width="40" Height="40" CornerRadius="20" Padding="0" UseLayoutRounding="True"

                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"

                                    Background="Transparent" BorderThickness="0"

                                   >

                                <Path x:Name="OpenSecondPdfGlyph" Width="32" Height="32"
                                      Data="M16,8 L16,24 M8,16 L24,16"
                                      Stroke="{Binding ElementName=OpenSecondPdfButton, Path=Foreground}"
                                      StrokeThickness="2"
                                      Stretch="None"
                                      StrokeStartLineCap="Flat" StrokeEndLineCap="Flat"/>

                            </Button>

                        </Border>

                    </Grid>



                    <Grid x:Name="SecondaryClosePill"

                          HorizontalAlignment="Right" VerticalAlignment="Top"

                          Margin="0,47,4,0" Padding="8"

                          Background="Transparent" Canvas.ZIndex="40"

                          PointerEntered="SecondaryClosePill_PointerEntered"

                          PointerExited="SecondaryClosePill_PointerExited">

                        <Grid.Resources>

                            <Storyboard x:Name="SecondaryClosePillShowAnim">

                                <DoubleAnimation Storyboard.TargetName="SecondaryClosePillBorder" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>

                            </Storyboard>

                            <Storyboard x:Name="SecondaryClosePillHideAnim">

                                <DoubleAnimation Storyboard.TargetName="SecondaryClosePillBorder" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>

                            </Storyboard>

                        </Grid.Resources>

                        <Border x:Name="SecondaryClosePillBorder"

                                Background="{ThemeResource FlyoutPresenterBackground}"

                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"

                                BorderThickness="1"

                                CornerRadius="20"

                                Opacity="0"

                                local:ElevationShadow.IsEnabled="True" local:ElevationShadow.Elevation="18">

                            <Button x:Name="CloseSecondPdfButton" Click="CloseSecondPdf_Click" Style="{StaticResource ButtonNoStateMachineStyle}"

                                    Width="40" Height="40" CornerRadius="20" Padding="0" UseLayoutRounding="True"

                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"

                                    Background="Transparent" BorderThickness="0"

                                   >

                                <Path x:Name="CloseSecondPdfGlyph" Width="32" Height="32"
                                      Data="M10,10 L22,22 M10,22 L22,10"
                                      Stroke="{Binding ElementName=CloseSecondPdfButton, Path=Foreground}"
                                      StrokeThickness="2"
                                      Stretch="None"
                                      StrokeStartLineCap="Flat" StrokeEndLineCap="Flat"/>

                            </Button>

                        </Border>

                    </Grid>

                </Grid>



                <!-- Floating bottom zoom pill: translucent overlay on the PDF; hover to highlight -->

                <Grid x:Name="BottomZoomPill"

                      Grid.Column="0"

                      VerticalAlignment="Bottom" HorizontalAlignment="Right"

                      Margin="12,10"

                      Canvas.ZIndex="50"

                      PointerEntered="BottomZoomPill_PointerEntered"

                      PointerExited="BottomZoomPill_PointerExited">

                    <Grid.Resources>

                        <Storyboard x:Name="BottomPillShowAnim">

                            <DoubleAnimation Storyboard.TargetName="BottomZoomPillBorder" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>

                        </Storyboard>

                        <Storyboard x:Name="BottomPillHideAnim">

                            <DoubleAnimation Storyboard.TargetName="BottomZoomPillBorder" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>

                        </Storyboard>

                    </Grid.Resources>

                    <Border x:Name="BottomZoomPillBorder"

                            Background="{ThemeResource FlyoutPresenterBackground}"

                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"

                            BorderThickness="1"

                            CornerRadius="20"

                            Padding="6,4"

                            Height="42"

                            Opacity="0"

                            local:ElevationShadow.IsEnabled="True" local:ElevationShadow.Elevation="18">

                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">

                            <Button x:Name="ZoomOutButton" Style="{StaticResource ButtonNoStateMachineStyle}" Click="ZoomOut_Click" Width="32" Height="32" CornerRadius="16"
                                    UseLayoutRounding="True"
                                    Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"

                                    Background="Transparent" BorderThickness="0"

                                   >

                                <Path x:Name="ZoomOutGlyph" Width="32" Height="32" Data="M8,16 L24,16"
                                      Stroke="{Binding ElementName=ZoomOutButton, Path=Foreground}" StrokeThickness="2"
                                      Stretch="None" StrokeStartLineCap="Flat" StrokeEndLineCap="Flat"/>

                            </Button>

                            <Button x:Name="ZoomInButton" Style="{StaticResource ButtonNoStateMachineStyle}" Click="ZoomIn_Click" Width="32" Height="32" CornerRadius="16"
                                    UseLayoutRounding="True"
                                    Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"

                                    Background="Transparent" BorderThickness="0"

                                   >

                                <Path x:Name="ZoomInGlyph" Width="32" Height="32" Data="M16,8 L16,24 M8,16 L24,16"
                                      Stroke="{Binding ElementName=ZoomInButton, Path=Foreground}" StrokeThickness="2"
                                      Stretch="None" StrokeStartLineCap="Flat" StrokeEndLineCap="Flat"/>

                            </Button>

                            <Button x:Name="ZoomValueButton" Style="{StaticResource ButtonNoStateMachineStyle}" Padding="8,4" MinWidth="56" Height="32" CornerRadius="16"

                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"

                                    Background="Transparent" BorderThickness="0"

                                   >

                                <TextBlock x:Name="ZoomValueText" Text="100%" TextAlignment="Center"

                                           VerticalAlignment="Center"

                                           Foreground="{Binding ElementName=ZoomValueButton, Path=Foreground}"

                                           Margin="3,-2,0,0"/>

                                <Button.Flyout>

                                    <Flyout x:Name="ZoomPresetFlyout" Placement="Top" FlyoutPresenterStyle="{StaticResource ZoomFlyoutPresenterStyle}" Opening="ZoomPresetFlyout_Opening" Closed="ZoomPresetFlyout_Closed">

                                        <!-- Background=Transparent：让面板整片可命中，PointerMoved 才能覆盖凹缝（面板驱动独占 hover，见 MainPage.xaml.cs） -->
                                        <StackPanel x:Name="ZoomPresetPanel" Spacing="0" Background="Transparent">

                                            <Button Content="10%" Click="ZoomPreset_Click" Tag="10" Style="{StaticResource ZoomFlyoutItemNoStateMachineStyle}"/>

                                            <Button Content="25%" Click="ZoomPreset_Click" Tag="25" Style="{StaticResource ZoomFlyoutItemNoStateMachineStyle}"/>

                                            <Button Content="50%" Click="ZoomPreset_Click" Tag="50" Style="{StaticResource ZoomFlyoutItemNoStateMachineStyle}"/>

                                            <Button Content="75%" Click="ZoomPreset_Click" Tag="75" Style="{StaticResource ZoomFlyoutItemNoStateMachineStyle}"/>

                                            <Button Content="100%" Click="ZoomPreset_Click" Tag="100" Style="{StaticResource ZoomFlyoutItemNoStateMachineStyle}"/>

                                            <Button Content="125%" Click="ZoomPreset_Click" Tag="125" Style="{StaticResource ZoomFlyoutItemNoStateMachineStyle}"/>

                                            <Button Content="150%" Click="ZoomPreset_Click" Tag="150" Style="{StaticResource ZoomFlyoutItemNoStateMachineStyle}"/>

                                            <Button Content="200%" Click="ZoomPreset_Click" Tag="200" Style="{StaticResource ZoomFlyoutItemNoStateMachineStyle}"/>

                                        </StackPanel>

                                    </Flyout>

                                </Button.Flyout>

                            </Button>

                            <Button x:Name="FitWidthButton" Style="{StaticResource ButtonNoStateMachineStyle}" Click="FitWidth_Click" Width="32" Height="32" CornerRadius="16"
                                    UseLayoutRounding="True"
                                    Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"

                                    Background="Transparent" BorderThickness="0"

                                   >

                                <Path x:Name="FitWidthGlyph" Width="32" Height="32"
                                      Data="M8,12 L8,8 L12,8 M24,12 L24,8 L20,8 M8,20 L8,24 L12,24 M24,20 L24,24 L20,24"
                                      Stroke="{Binding ElementName=FitWidthButton, Path=Foreground}" StrokeThickness="2"
                                      Stretch="None" StrokeStartLineCap="Flat" StrokeEndLineCap="Flat" StrokeLineJoin="Miter"/>

                            </Button>

                        </StackPanel>

                    </Border>

                </Grid>



                <!-- 保存/书签提示胶囊栈（微信式堆叠）：

                     • 新动作在「标准位置」（左下角底边，Margin 12,10）生成新胶囊，旧胶囊整体上移一格；

                     • 每枚胶囊各自独立计时 2s（从自身创建起算 → 最旧先到期），到时淡出；点击即消；

                     • 栈深上限 SaveToastMax(=5) 触发时强制淡出最顶（最旧）一枚，防止无限堆积。

                     定位完全由每枚胶囊的 TranslateTransform.Y(= -Pos×SaveToastSlot) 控制；

                     容器是单格 Grid，不因新增子项而自动重排，故所有位移都能平滑 Storyboard 动画。

                     注：09-24 的「A/B 双槽位交替」方案已整体回退，本实现不走双槽位。 -->

                <Grid x:Name="SaveToastStack"

                      Grid.Column="0"

                      VerticalAlignment="Bottom" HorizontalAlignment="Left"

                      Margin="12,10"

                      Canvas.ZIndex="2000"/>

            </Grid>

        </SplitView>



        <!-- Bottom zoom controls are now a translucent floating pill overlaid on the PDF (see inside ViewerContainerGrid) -->

        <!-- Save toast (bottom-left) is also placed inside ViewerContainerGrid so it shares the

             exact same layout coordinate space as the bottom-right zoom pill. This guarantees

             pixel-perfect margin symmetry and identical height without any reference frame drift. -->

        <!-- ================= Operations guide overlay =================
             Hosted deliberately in the MAIN visual tree (last child of the page root grid, painted above
             the SplitView via ZIndex) rather than in a Flyout/Popup: a popup is a separate visual tree
             with a null parent chain, so it does NOT inherit the window RequestedTheme and would fall
             back to the system theme instead of the app's own light/dark setting — see App.xaml header.
             Consequently this references ONLY stock ThemeResource brushes already proven elsewhere in
             this project (SolidBackgroundFillColorBaseBrush / CardStrokeColorDefaultBrush /
             ControlCornerRadius / SystemControlForegroundBaseMediumBrush); no custom App.xaml key is
             referenced from the main tree, which is what previously broke theme switching. Text uses the
             default foreground so it adapts to the request theme automatically. -->
        <Grid x:Name="GuideOverlay" Visibility="Collapsed" Canvas.ZIndex="3000">

            <Grid.Resources>
                <!-- Shared row template for both the mouse and the keyboard section. -->
                <DataTemplate x:Key="GuideRowTemplate" x:DataType="local:GuideRow">
                    <Grid Padding="0,5" ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- 手势/按键胶囊：边框必须用 ControlStrongStrokeColorDefaultBrush（浅 45% 黑 / 深 55% 白），
                             原先的 CardStrokeColorDefaultBrush 浅色档只有 6% 黑 → 框几乎隐形，视觉上像"下方缺一块"。
                             浅底用 ControlFillColorDefaultBrush（浅 70% 白）给出键帽观感。二者均为 WinUI 原生键
                             （同 CardStrokeColorDefaultBrush 一族），非自定义 App 键，不触碰主题切换雷区。
                             MinHeight + VerticalAlignment=Center + 上下 4px 内边距：保证文字永不贴边/被裁。
                             Width=140（全列等宽）：胶囊默认贴内容自适应宽度时，连同为单字母的 F/G 都因字形宽度不同而大小不一。
                             140 是按【三语最长标签】取的：zh「画笔模式：左键拖动」≈128、en「Pen mode: left-drag」≈115、
                             es「Modo lápiz: arrastre」≈120，均可单行容纳。es 原本的冗长写法（最长 ≈247）已同步收短，
                             否则固定宽会把西语那几条挤成两行（宽虽等、高却乱）。用固定 Width 而非 MinWidth：任一语言下宽度都一致。 -->
                        <Border Grid.Column="0"
                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="{ThemeResource ControlCornerRadius}"
                                Padding="10,4" MinHeight="28" Width="140"
                                HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Gesture}" FontSize="12"
                                       TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <!-- FontSize 必须是整数 12（= 标准 Caption 档）：原来是 12.5，是全仓库唯一的非整数字号，
                             在 100/125/150/175% 四档缩放下都落在非整数像素上，行盒高度非整数会导致相邻行的
                             基线交替错半像素、行距忽宽忽窄（16 行密集列表里最明显）。12 在五档 DPI 下全是整数。 -->
                        <TextBlock Grid.Column="1" Text="{x:Bind Description}" FontSize="12"
                                   TextWrapping="Wrap" VerticalAlignment="Center"
                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                    </Grid>
                </DataTemplate>
            </Grid.Resources>

            <!-- Dimmed backdrop; tapping it dismisses the guide. A neutral black scrim reads correctly in both themes. -->
            <Grid x:Name="GuideScrim" Background="Black" Opacity="0.35" Tapped="GuideScrim_Tapped"/>

            <Border x:Name="GuideCard"
                    Margin="40,32" MaxWidth="720"
                    HorizontalAlignment="Center" VerticalAlignment="Stretch"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource ControlCornerRadius}"
                    Padding="24,20">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" x:Name="GuideTitleText" Text="Operations Guide"
                               FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>

                    <ScrollViewer Grid.Row="1" Margin="0,16" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0">
                        <StackPanel Spacing="22">

                            <StackPanel Spacing="10">
                                <TextBlock x:Name="GuideMouseSectionText" Text="Mouse Operations"
                                           FontSize="14" FontWeight="SemiBold"/>
                                <ItemsControl x:Name="GuideMouseItems"
                                              ItemTemplate="{StaticResource GuideRowTemplate}"/>
                            </StackPanel>

                            <StackPanel Spacing="10">
                                <TextBlock x:Name="GuideKeyboardSectionText" Text="Keyboard Shortcuts"
                                           FontSize="14" FontWeight="SemiBold"/>
                                <ItemsControl x:Name="GuideKeyboardItems"
                                              ItemTemplate="{StaticResource GuideRowTemplate}"/>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>

                    <Button Grid.Row="2" x:Name="GuideCloseButton" Content="Close"
                            Style="{StaticResource ButtonNoStateMachineStyle}"
                            HorizontalAlignment="Right" IsTabStop="False"
                            Padding="16,7" Click="GuideCloseButton_Click"/>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</Page>
