<?xml version="1.0" encoding="utf-8" ?>

<Page

    x:Class="GlanceRX.MainPage"

    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"

    xmlns:local="using:GlanceRX"

    xmlns:services="using:GlanceRX.Services"

    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

    mc:Ignorable="d"

    Background="Transparent"

    KeyboardAcceleratorPlacementMode="Hidden">



    <Page.Resources>

        <!-- 资源管理器一行的状态配色。空白态 = 透明（露出面板底色）：
             悬浮 = 比底色亮一档的灰，按下 = 比悬浮暗一档。
             【选中态】两档：单选（普通点击选中的那一行）= 中性灰底，多选（Ctrl/Shift 选出的批）= 强调紫淡染。
             【激活态】不占底色 —— 它是行首那条竖条（CanvasRowActiveBarBrush），与选中态互不遮挡：
             "开着哪份画布"和"选中了哪几行"是两件事，会同时出现在同一行上。
             深/浅两套具体色值由 UpdateSidebarBackground 按主题写进这几支画刷。 -->

        <SolidColorBrush x:Key="CanvasRowHoverBrush" Color="#F2F2F2"/>

        <SolidColorBrush x:Key="CanvasRowPressedBrush" Color="#E0E0E0"/>

        <SolidColorBrush x:Key="CanvasRowSelectedBrush" Color="#FBFBFB"/>

        <SolidColorBrush x:Key="CanvasRowMultiSelectBrush" Color="#D8D0ED"/>

        <!-- 侧栏 / 面板的文字色，按"离背景的亮度差"分四档，深淡两套由 UpdateSidebarBackground 写。
             一律不用默认前景色：WinUI 深色档的默认文字是纯白 #FFFFFF，整列文件名铺开时刺眼。
             阶梯（高 → 低）：激活行名字 > 列表项名称 > 非激活行名字 > 标题/页码这类附属信息。
             画布行的名字、箭头、图标三处都绑 CanvasTreeNode.NameBrush，
             所以"激活"在整行上同时生效，不依赖缩进多深 —— 行首那条竖条在深层级时离名字太远。 -->

        <SolidColorBrush x:Key="SidebarTextBrush" Color="#202026"/>

        <SolidColorBrush x:Key="SidebarTextMutedBrush" Color="#6B6B74"/>

        <SolidColorBrush x:Key="CanvasRowTextBrush" Color="#60606A"/>

        <SolidColorBrush x:Key="CanvasRowTextActiveBrush" Color="#0A0A0E"/>

        <SolidColorBrush x:Key="CanvasRowActiveBarBrush" Color="#9873F7"/>

        <!-- 行容器：ListViewItem 只当"一行"的载体，模板里什么都不画。
             四种状态底色由行模板自己上 —— 框架的选中态改不动也改不准（文件夹抢高亮、悬浮吃掉选中色都是这么来的）。
             行高固定 22；IsTabStop=False + 无焦点框 ⇒ 列表里没有任何能拿键盘焦点的元素，
             于是不会出现"退出改名后一个白框还能上下移动"的问题。 -->

        <Style x:Key="CanvasRowItemStyle" TargetType="ListViewItem">

            <Setter Property="IsTabStop" Value="False"/>

            <Setter Property="UseSystemFocusVisuals" Value="False"/>

            <!-- 这三个必须显式归零：模板被整体替换后，容器高度仍受 ListViewItem 自身的最小高度约束
                 （框架默认 32），会把 22 高的行内容撑到 32 —— 上下多出来的那几像素落在行内容之外，
                 点上去没有任何行接收 ⇒ 表现为"行间死区、每行有效点击区域小"。 -->

            <Setter Property="MinHeight" Value="0"/>

            <Setter Property="Margin" Value="0"/>

            <Setter Property="Padding" Value="0"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ListViewItem">

                        <!-- 模板自包含：不留 Padding / 不画任何状态底色（底色在行模板的 Border 上）。
                             高度交给内容自己（MinHeight=22），内容拉伸填满容器 ⇒ 命中面 = 整行，不留缝。 -->

                        <Grid Background="Transparent">

                            <ContentPresenter x:Name="ContentPresenter" Content="{TemplateBinding Content}"

                                              ContentTemplate="{TemplateBinding ContentTemplate}"

                                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"

                                              HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>

                        </Grid>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- 资源管理器的一行：缩进 + 展开箭头 + 图标 + 名字。整行都是命中区 —— 根 Grid 的透明底色就是命中面
             （子元素无背景时不参与命中测试，事件冒泡到这层；行底色 Border 可能是 null，指望不上它）。
             PointerPressed 里只落"选中"，主动作（打开画布 / 展开文件夹）留到抬起时结算：
             长按拖拽要占用同一次按下，若按下就展开，行集合会在拖拽开始前被重排一遍。
             动作按【节点引用】执行、不按容器（见 CommitCanvasPress），所以行集合即使在
             按下与抬起之间被刷新过也不会丢。 -->

        <DataTemplate x:Key="CanvasRowTemplate" x:DataType="services:CanvasTreeNode">

            <!-- MinHeight = 行高：容器不设固定高度，行高由这里唯一决定（改这一处就是改行高）。
                 HorizontalAlignment/VerticalAlignment 显式 Stretch：透明根必须铺满容器，否则整行点不全。 -->

            <Grid Background="Transparent" MinHeight="22"

                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"

                  PointerEntered="CanvasRow_PointerEntered" PointerExited="CanvasRow_PointerExited"

                  PointerPressed="CanvasRow_PointerPressed" PointerReleased="CanvasRow_PointerReleased">

                <Border Background="{x:Bind RowBackground, Mode=OneWay}"/>

                <!-- 激活态：行首竖条（vscode 活动列表项的做法）。整行高度、贴左缘，
                     与"选中底"互不遮挡 ⇒ 一行可以同时是"开着的"和"选中的"。
                     只做左边一条：右缘在横向滚动后不再贴着可视区右边，画出来会像"虚线框"，
                     而且与"多选紫底"叠在一起分不清哪个是激活。 -->

                <Border Width="4" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                        Background="{StaticResource CanvasRowActiveBarBrush}"
                        Visibility="{x:Bind ActiveBarMark, Mode=OneWay}"/>

                <Grid Margin="2,0,6,0" ColumnSpacing="4">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="Auto"/>

                        <ColumnDefinition Width="Auto"/>

                        <ColumnDefinition Width="Auto"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="{x:Bind IndentWidth}"/>

                    <!-- 箭头列宽固定 12：文件行不显示箭头，但列仍然占位，否则文件和文件夹的图标会错开。
                         箭头与图标的前景色一律绑 NameBrush：FontIcon 不继承 TextBlock 的前景色，
                         漏掉就永远是主题默认的白，整行亮度被图标拉平，名字上的亮度差等于白做。 -->

                    <Grid Grid.Column="1" Width="12" VerticalAlignment="Center">

                        <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="10"
                                  Foreground="{x:Bind NameBrush, Mode=OneWay}"
                                  Glyph="{x:Bind ChevronGlyph, Mode=OneWay}" Visibility="{x:Bind ChevronMark}"/>

                    </Grid>

                    <Grid Grid.Column="2" VerticalAlignment="Center">

                        <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE8B7;" FontSize="14"
                                  Foreground="{x:Bind NameBrush, Mode=OneWay}"
                                  Visibility="{x:Bind FolderIconMark}"/>

                        <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="{x:Bind FileGlyph, Mode=OneWay}" FontSize="14"
                                  Foreground="{x:Bind NameBrush, Mode=OneWay}"
                                  Visibility="{x:Bind FileIconMark}"/>

                    </Grid>

                    <!-- 名字：平时文本，改名时换成行内输入框（与书签同一套控件）。
                         HorizontalAlignment=Left：让 TextBlock 的宽度始终等于文本自然宽度。
                         默认 Stretch 会把它拉成整列宽（列是 *，行被撑到"最宽一行"后短名字会被拉长），
                         那样"新建后横向滚到看得见名字"就算不出真正的右端位置。
                         Margin 左边 4 与输入框内文字的左内边距一致 ⇒ 进/出编辑态文字不横向跳。 -->

                    <TextBlock Grid.Column="3" Text="{x:Bind Name}" FontSize="12" VerticalAlignment="Center"
                               HorizontalAlignment="Left" Margin="4,0,0,0"
                               Foreground="{x:Bind NameBrush, Mode=OneWay}"
                               TextTrimming="CharacterEllipsis" Visibility="{x:Bind NameTextMark, Mode=OneWay}"/>

                    <!-- 改名：框只是装饰，"文字"自己跟名字走同一条算式。
                         框 = 固定 20 高、行内居中（比一行 16 多出上下各 2，大字号下也不贴边）；
                         文字 = 恰好一行高（AutoHeight）+ 行内居中，
                         与左边名字 TextBlock 的"一行高 + 居中"完全相同 ⇒ 进出编辑零位移。
                         框高【不要】改成跟随行高：那会重新引入"尺寸联动 + 第二层居中"，
                         文字会再次相对名字偏移。框与文字是两个独立兄弟节点，改框高不动文字。
                         也不要把文字塞进框里居中：每多一层居中就多一次像素舍入
                         （125% 缩放下每层舍到 0.8DIP 格），文字会比名字低约 1 个物理像素。 -->

                    <Border Grid.Column="3" Height="20" VerticalAlignment="Center" CornerRadius="4"
                            BorderThickness="1" Background="Transparent"
                            BorderBrush="{StaticResource CanvasRowActiveBarBrush}"
                            Visibility="{x:Bind IsRenaming, Mode=OneWay}"/>

                    <local:SelfDrawnTextBox Grid.Column="3" AutoHeight="True" FontSize="12" VerticalAlignment="Center"
                                            ShowFrame="False"
                                            Text="{x:Bind RenameText, Mode=TwoWay}"
                                            Visibility="{x:Bind IsRenaming, Mode=OneWay}"
                                            Submitted="CanvasRowRename_Submitted"
                                            Cancelled="CanvasRowRename_Cancelled"
                                            CommitRequested="CanvasRowRename_CommitRequested"/>

                </Grid>

            </Grid>

        </DataTemplate>

        <!-- 【共用】ToggleButton 视觉状态机接管样式 —— 已用于：顶部工具栏「阅读模式」按钮、

             侧边栏「缩略图 / 书签 / 大纲」三模式切换键（共 4 颗）。

             外观与 DefaultToggleButtonStyle（generic.xaml:27811-28013）完全逐行等价 ——

             那 12 个 setter 与模板正文都逐字抄自基类（含 HorizontalAlignment=Left / VerticalAlignment=Center，

             见 generic.xaml:27818-27819），唯一的区别是【不带 VisualStateGroups / BackgroundTransition】：

             原生 CommonStates 那套 Storyboard 直接不存在了，谁也抢不走模板根的四个视觉属性，

             颜色改由 Services/ToggleButtonVisualOverride.cs 独占写入（取值与状态表同源）。

             这里刻意【不用 BasedOn】而是把基类的 setter 逐条抄进来：派生样式能否覆盖基类 Template

             属于未记载行为，自包含样式没有这个假设，外观也不依赖基类任何一个 setter 还在不在。

             改这里前先对着 generic.xaml:27812-27825 核对一遍。 -->

        <Style x:Key="ToggleButtonNoStateMachineStyle" TargetType="ToggleButton">

            <Setter Property="Background" Value="{ThemeResource ToggleButtonBackground}" />

            <Setter Property="BackgroundSizing" Value="InnerBorderEdge" />

            <Setter Property="Foreground" Value="{ThemeResource ToggleButtonForeground}" />

            <Setter Property="BorderBrush" Value="{ThemeResource ToggleButtonBorderBrush}" />

            <Setter Property="BorderThickness" Value="{ThemeResource ToggleButtonBorderThemeThickness}" />

            <Setter Property="Padding" Value="{StaticResource ButtonPadding}" />

            <Setter Property="HorizontalAlignment" Value="Left" />

            <Setter Property="VerticalAlignment" Value="Center" />

            <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />

            <Setter Property="FontWeight" Value="Normal" />

            <Setter Property="FontSize" Value="{ThemeResource ControlContentThemeFontSize}" />

            <Setter Property="UseSystemFocusVisuals" Value="{StaticResource UseSystemFocusVisuals}" />

            <Setter Property="FocusVisualMargin" Value="-3" />

            <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ToggleButton">

                        <ContentPresenter x:Name="ContentPresenter"

                                          Background="{TemplateBinding Background}"

                                          Foreground="{TemplateBinding Foreground}"

                                          BackgroundSizing="{TemplateBinding BackgroundSizing}"

                                          BorderBrush="{TemplateBinding BorderBrush}"

                                          BorderThickness="{TemplateBinding BorderThickness}"

                                          Content="{TemplateBinding Content}"

                                          ContentTemplate="{TemplateBinding ContentTemplate}"

                                          ContentTransitions="{TemplateBinding ContentTransitions}"

                                          CornerRadius="{TemplateBinding CornerRadius}"

                                          Padding="{TemplateBinding Padding}"

                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"

                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"

                                          AutomationProperties.AccessibilityView="Raw"/>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>






        <!-- 缩放预设浮层 8 颗：同机制，但【逐条抄 ZoomFlyoutItemStyle 的全部 setter】再换无状态机模板。

             ⚠ 任何 NoStateMachineStyle 都必须「基样式 setter + Template 全抄，仅删状态机」——

               只抄 Template 会丢 Padding / CornerRadius / Foreground 而让外观变形（09-29 实测踩过）。 -->
        <Style x:Key="ZoomFlyoutItemNoStateMachineStyle" TargetType="Button">
            <Setter Property="IsTabStop" Value="False"/>
            <!-- 上下不对称 Padding（上 7 / 下 9，总高不变）：抵消字体行盒下降部预留，把居中文字整体上移 1px。 -->
            <Setter Property="Padding" Value="16,7,16,9"/>
            <!-- 居中对齐 + 字号与项目其它按钮同源（字体键必须用 ContentControlThemeFontFamily，
                 不是 ControlContentThemeFontFamily —— 后者在本 WinUI 版本不存在，会 XamlParseException 崩启动，10-02 踩过）。
                 HorizontalAlignment=Stretch 让按钮铺满菜单行宽，配合 HorizontalContentAlignment=Center
                 使文字在整条菜单内水平居中（消除 MinWidth=80 右侧留空造成的左贴边）。 -->
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}"/>
            <Setter Property="FontSize" Value="{ThemeResource ControlContentThemeFontSize}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Foreground" Value="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <ContentPresenter x:Name="ContentPresenter"

                                          Background="{TemplateBinding Background}"

                                          Foreground="{TemplateBinding Foreground}"

                                          BackgroundSizing="{TemplateBinding BackgroundSizing}"

                                          BorderBrush="{TemplateBinding BorderBrush}"

                                          BorderThickness="{TemplateBinding BorderThickness}"

                                          Content="{TemplateBinding Content}"

                                          ContentTemplate="{TemplateBinding ContentTemplate}"

                                          ContentTransitions="{TemplateBinding ContentTransitions}"

                                          CornerRadius="{TemplateBinding CornerRadius}"

                                          Padding="{TemplateBinding Padding}"

                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"

                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"

                                          AutomationProperties.AccessibilityView="Raw"/>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>
        </Style>

        <!-- 书签行容器：换掉原生 ListViewItem 的悬浮判定机制，【外观三档颜色不变】。

             为什么必须换（10-17 定案）：原生 ListViewItemPresenter 靠框架的 IsPointerOver 判悬浮，
             而行内任何元素一旦 CapturePointer（4 颗 Button 的 ButtonBase 内建行为、自绘编辑框的
             拖选刚需），框架就给行派发一次【假 PointerExited】⇒ 整行悬浮色当场消失、松手后约
             380ms 框架补发 Entered 才回来 —— 即用户实测的"乱闪"。这是框架内部行为，应用层关不掉；
             唯一出路是不再采信任何框架悬停标记，改由【指针几何】判定（与工具栏按钮的
             ButtonVisualOverride 同一范式），谁捕获指针都不影响。

             三档颜色仍逐字引用 generic 的 ListViewItemBackground{,PointerOver,Pressed}
             （= SubtleFillColor{Transparent,Secondary,Tertiary}）⇒ 常态 / 悬浮 / 点击色与改前逐像素一致，
             且主题切换由 ThemeResource 自动跟随，无需代码介入。

             三档底色【刻意不挂 VSM 组】：ListViewItem 控件自身的状态机会以 IsPointerOver 为依据调用
             GoToState("Normal"|"PointerOver"|"Pressed")，而它遍历模板内【所有】VSM 组 ⇒ 我们一旦定义
             同名状态就会被它抢；故改由代码 ApplyBookmarkRowVisual 直接切三层 Border 的 Visibility
             （无 Storyboard，赋相同 Visibility 不触发布局）⇒ 切换瞬时，框架无组可切，本机制独占。 -->
        <Style x:Key="BookmarkListItemStyle" TargetType="ListViewItem">

            <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}"/>

            <Setter Property="FontSize" Value="{ThemeResource ControlContentThemeFontSize}"/>

            <Setter Property="Background" Value="Transparent"/>

            <Setter Property="Foreground" Value="{ThemeResource ListViewItemForeground}"/>

            <Setter Property="TabNavigation" Value="Local"/>

            <Setter Property="Padding" Value="16,0,12,0"/>

            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>

            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <Setter Property="MinWidth" Value="{ThemeResource ListViewItemMinWidth}"/>

            <Setter Property="MinHeight" Value="{ThemeResource ListViewItemMinHeight}"/>

            <Setter Property="UseSystemFocusVisuals" Value="True"/>

            <Setter Property="FocusVisualMargin" Value="1"/>

            <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource ListViewItemFocusVisualPrimaryBrush}"/>

            <Setter Property="FocusVisualPrimaryThickness" Value="2"/>

            <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource ListViewItemFocusVisualSecondaryBrush}"/>

            <Setter Property="FocusVisualSecondaryThickness" Value="1"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ListViewItem">

                        <Grid x:Name="RowRoot">

                            <!-- 全行透明命中层：三档底色【内缩】后，被缩掉的边缘仍有它顶着 ⇒
                                 行的左右 / 上下边缘照样可点（与原生一致：容器本身就是命中目标）。
                                 ⚠ 无 x:Name ⇒ ApplyBookmarkRowVisual 遍历时不会被改名、Visibility 也不动。 -->

                            <Border Background="Transparent"/>

                            <!-- 三档底色叠放，按状态切显隐：底色取值与原生逐键同源。
                                 左右各留 4、上下各留 2 ⇒ 行与行之间有缝、左右不贴边，
                                 与缩略图 / 大纲模式（兄弟列表）的观感对齐（原生 ListViewItemPresenter 的背景同样不铺满）。
                                 CornerRadius 用 ControlCornerRadius（4）与 Fluent 卡片一致。
                                 【数值来源】10-17 截图像素取证，两个独立锚点（书签悬浮色高 45px ÷ 36 DIP、
                                 面板宽 275px ÷ 220 DIP）各自得 1.250 px/DIP ⇒ 定标可信；
                                 大纲（目标）左右内缩实测 5px = 4.0 DIP，书签（当时 Margin=8）实测 10px = 8.0 DIP
                                 （与其代码值闭环吻合）⇒ 左右由 8 改 4。上下经比对两图一致，保持 2。
                                 ⚠ 这两个数就是可调点，要再对齐只改这里的 Margin / CornerRadius。 -->

                            <Border x:Name="RestLayer" Margin="4,2,4,2" CornerRadius="{ThemeResource ControlCornerRadius}" Background="{ThemeResource ListViewItemBackground}"/>

                            <Border x:Name="HoverLayer" Margin="4,2,4,2" CornerRadius="{ThemeResource ControlCornerRadius}" Background="{ThemeResource ListViewItemBackgroundPointerOver}" Visibility="Collapsed"/>

                            <Border x:Name="PressedLayer" Margin="4,2,4,2" CornerRadius="{ThemeResource ControlCornerRadius}" Background="{ThemeResource ListViewItemBackgroundPressed}" Visibility="Collapsed"/>

                            <ContentPresenter x:Name="ContentPresenter"

                                              Content="{TemplateBinding Content}"

                                              ContentTemplate="{TemplateBinding ContentTemplate}"

                                              ContentTransitions="{TemplateBinding ContentTransitions}"

                                              Padding="{TemplateBinding Padding}"

                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"

                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"

                                              Control.IsTemplateFocusTarget="True"/>

                            <!-- ⚠ 这里【刻意不挂 VisualStateManager.VisualStateGroups】：
                                 ListViewItem 控件自身的状态机（UpdateVisualState）会以 IsPointerOver / IsSelected
                                 为依据调用 GoToState("Normal"|"PointerOver"|"Pressed")，而它遍历的是模板里【所有】
                                 VSM 组 ⇒ 若我们定义同名状态，它会命中并与几何判定抢夺同一批属性 —— 假 PointerExited
                                 一到它就把行切回 Normal（10-17 实测"改了完全没变化"的根因）。
                                 不挂组 ⇒ 框架无组可切；三档底色改由 MainPage 的 ApplyBookmarkRowVisual 独占写入。 -->

                        </Grid>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>
        </Style>

        <Style x:Key="ZoomFlyoutPresenterStyle" TargetType="FlyoutPresenter">

            <Setter Property="Padding" Value="4,4"/>

            <Setter Property="BorderThickness" Value="1"/>

            <Setter Property="CornerRadius" Value="8"/>

            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>

            <Setter Property="Background" Value="{ThemeResource FlyoutPresenterBackground}"/>

            <Setter Property="MinWidth" Value="80"/>

            <Setter Property="Transitions">

                <Setter.Value>

                    <TransitionCollection/>

                </Setter.Value>

            </Setter>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="FlyoutPresenter">

                        <Border x:Name="FlyoutPresenterRoot"

                                Background="{TemplateBinding Background}"

                                BorderBrush="{TemplateBinding BorderBrush}"

                                BorderThickness="{TemplateBinding BorderThickness}"

                                CornerRadius="{TemplateBinding CornerRadius}"

                                Padding="{TemplateBinding Padding}"

                                RenderTransformOrigin="0.5,1"

                                Loaded="FlyoutPresenterRoot_Loaded">

                            <Border.RenderTransform>

                                <ScaleTransform x:Name="FlyoutScale" ScaleY="0"/>

                            </Border.RenderTransform>

                            <Border.Resources>

                                <Storyboard x:Name="OpenAnimation">

                                    <DoubleAnimation Storyboard.TargetName="FlyoutScale"

                                                     Storyboard.TargetProperty="ScaleY"

                                                     From="0" To="1" Duration="0:0:0.2">

                                        <DoubleAnimation.EasingFunction>

                                            <CubicEase EasingMode="EaseOut"/>

                                        </DoubleAnimation.EasingFunction>

                                    </DoubleAnimation>

                                </Storyboard>

                            </Border.Resources>

                            <ContentPresenter Content="{TemplateBinding Content}"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- 设置菜单专用磨砂样式：acrylic 背景与缩放菜单一致（FlyoutPresenterBackground 与浮动面板同支，深/浅色

             自适应），但 RenderTransformOrigin=0.5,0 使其从顶沿向下展开，匹配 BottomEdgeAlignedRight

             的向下弹出朝向（缩放菜单用 0.5,1 向上展开，两者动画方向各自正确、材质统一）。 -->

        <Style x:Key="SettingsFlyoutPresenterStyle" TargetType="FlyoutPresenter">

            <Setter Property="Padding" Value="4,4"/>

            <Setter Property="BorderThickness" Value="1"/>

            <Setter Property="CornerRadius" Value="8"/>

            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>

            <Setter Property="Background" Value="{ThemeResource FlyoutPresenterBackground}"/>

            <Setter Property="MinWidth" Value="80"/>

            <Setter Property="Transitions">

                <Setter.Value>

                    <TransitionCollection/>

                </Setter.Value>

            </Setter>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="FlyoutPresenter">

                        <Border x:Name="FlyoutPresenterRoot"

                                Background="{TemplateBinding Background}"

                                BorderBrush="{TemplateBinding BorderBrush}"

                                BorderThickness="{TemplateBinding BorderThickness}"

                                CornerRadius="{TemplateBinding CornerRadius}"

                                Padding="{TemplateBinding Padding}"

                                RenderTransformOrigin="0.5,0"

                                Loaded="FlyoutPresenterRoot_Loaded">

                            <Border.RenderTransform>

                                <ScaleTransform x:Name="FlyoutScale" ScaleY="0"/>

                            </Border.RenderTransform>

                            <Border.Resources>

                                <Storyboard x:Name="OpenAnimation">

                                    <DoubleAnimation Storyboard.TargetName="FlyoutScale"

                                                     Storyboard.TargetProperty="ScaleY"

                                                     From="0" To="1" Duration="0:0:0.2">

                                        <DoubleAnimation.EasingFunction>

                                            <CubicEase EasingMode="EaseOut"/>

                                        </DoubleAnimation.EasingFunction>

                                    </DoubleAnimation>

                                </Storyboard>

                            </Border.Resources>

                            <ContentPresenter Content="{TemplateBinding Content}"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>



    </Page.Resources>



    <Page.KeyboardAccelerators>

        <KeyboardAccelerator Key="Z" Modifiers="Control" Invoked="Undo_Invoked"/>

        <KeyboardAccelerator Key="Y" Modifiers="Control" Invoked="Redo_Invoked"/>

        <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="Save_Invoked"/>

        <KeyboardAccelerator Key="P" Modifiers="Control" Invoked="Print_Invoked"/>

        <KeyboardAccelerator Key="O" Modifiers="Control" Invoked="Open_Invoked"/>

        <KeyboardAccelerator Key="D" Modifiers="Control" Invoked="AddBookmark_Invoked"/>

        <!-- 缩放：Ctrl+= / Ctrl+- 与缩放胶囊 +/- 按钮等效；Ctrl+0 = 文件原始大小(100%)。主键盘与小键盘双绑定。 -->

        <KeyboardAccelerator Key="Add" Modifiers="Control" Invoked="ZoomIn_Invoked"/>

        <KeyboardAccelerator Key="Subtract" Modifiers="Control" Invoked="ZoomOut_Invoked"/>

        <KeyboardAccelerator Key="Number0" Modifiers="Control" Invoked="ZoomReset_Invoked"/>

        <KeyboardAccelerator Key="NumberPad0" Modifiers="Control" Invoked="ZoomReset_Invoked"/>

        <!-- 阅读区键盘导航（与焦点无关，走输入管理器全局分发） -->

        <KeyboardAccelerator Key="Up" Invoked="Nav_Invoked"/>

        <KeyboardAccelerator Key="Down" Invoked="Nav_Invoked"/>

        <KeyboardAccelerator Key="Left" Invoked="Nav_Invoked"/>

        <KeyboardAccelerator Key="Right" Invoked="Nav_Invoked"/>

        <KeyboardAccelerator Key="Space" Invoked="Nav_Invoked"/>

        <KeyboardAccelerator Key="PageDown" Invoked="Nav_Invoked"/>

        <KeyboardAccelerator Key="PageUp" Invoked="Nav_Invoked"/>

        <KeyboardAccelerator Key="Home" Invoked="Nav_Invoked"/>

        <KeyboardAccelerator Key="End" Invoked="Nav_Invoked"/>

        <!-- F：适应宽度（横向布局则相应适应高度），与 FitWidthButton 行为一致 -->

        <KeyboardAccelerator Key="F" Invoked="Fit_Invoked"/>

        <!-- G：切换画笔批注显示/隐藏（会话级临时隐藏，重开回到默认显示） -->

